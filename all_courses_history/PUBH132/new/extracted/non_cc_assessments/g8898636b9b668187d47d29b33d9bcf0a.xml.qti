              </material>
            </response_label>
            <response_label ident="6151">
              <material>
                <mattext texttype="text/plain">Spiritual wellness</mattext>
              </material>
            </response_label>
            <response_label ident="25">
              <material>
                <mattext texttype="text/plain">Intellectual wellness</mattext>
