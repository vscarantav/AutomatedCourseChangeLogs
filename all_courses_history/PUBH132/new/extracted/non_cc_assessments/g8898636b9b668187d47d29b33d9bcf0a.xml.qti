    <item ident="gc29aa7c95c3c5f3338e95c6b39135cf0" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>9487,7082,84,4674</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW154068732 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW154068732 BCX8"&gt;What&lt;/span&gt;&lt;span class="NormalTextRun SCXW154068732 BCX8"&gt; is an example of a mixed message in communication?&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW154068732 BCX8" data-ccp-props="{}"&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="9487">
              <material>
                <mattext texttype="text/plain">Your body language contradicts your spoken words.</mattext>
              </material>
            </response_label>
            <response_label ident="7082">
              <material>
                <mattext texttype="text/plain">You speak clearly and concisely.</mattext>
              </material>
            </response_label>
            <response_label ident="84">
              <material>
                <mattext texttype="text/plain">You use "I" messages effectively.</mattext>
              </material>
            </response_label>
            <response_label ident="4674">
              <material>
                <mattext texttype="text/plain">You listen attentively to others.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9487</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9487_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">7082</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="7082_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">84</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="84_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">4674</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="4674_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">9487</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="9487_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW65406101 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW65406101 BCX8"&gt;When our verbal and nonverbal messages don't correspond, we send a mixed message. It's important when sending messages (verbal or nonverbal) to make sure our body language agrees with our words.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW65406101 BCX8" data-ccp-props="{}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="7082_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW6192160 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW6192160 BCX8"&gt; Clear and concise speaking aligns verbal and nonverbal messages, rather than creating a mixed message.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW6192160 BCX8" data-ccp-props="{}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="84_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW264250769 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW264250769 BCX8"&gt;Using "I" messages enhances communication and does not inherently create a mixed message.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW264250769 BCX8" data-ccp-props="{}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="4674_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW146180333 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW146180333 BCX8"&gt;Attentive listening is a key communication skill, not an example of a mixed message.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW146180333 BCX8" data-ccp-props="{}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g77b715ef93e59a6c6a17f6310abf0676" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
