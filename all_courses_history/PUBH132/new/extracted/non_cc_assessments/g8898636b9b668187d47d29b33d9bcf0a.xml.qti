            <mattext texttype="text/html">&lt;span class="TextRun SCXW102240801 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW102240801 BCX8"&gt;"They" messages generalize or attribute actions to unspecified third parties, which does not focus on the speaker's personal feelings or experiences to improve communication.  &lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW102240801 BCX8" data-ccp-props="{}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="2884_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW116340878 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW116340878 BCX8"&gt;"We" messages are useful for promoting collaboration or shared responsibility, but they do not specifically emphasize the speaker's individual feelings and experiences in the same way that "I" messages do for clear, non-blaming communication. &lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW116340878 BCX8" data-ccp-props="{}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g4e2549f28c70ed0dba480bd9773224cd" title="Question">
