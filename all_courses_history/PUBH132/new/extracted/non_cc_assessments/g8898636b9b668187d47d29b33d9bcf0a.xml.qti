            <fieldentry>3433,366,2893,6613</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW262759770 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun ContextualSpellingAndGrammarErrorV2Themed SCXW262759770 BCX8"&gt;Social&lt;/span&gt;&lt;span class="NormalTextRun SCXW262759770 BCX8"&gt; wellness is strengthened by forming strong mutual attachments with others. These relationships can form between which of the following?&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW262759770 BCX8" data-ccp-props="{}"&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="3433">
              <material>
                <mattext texttype="text/plain">Parents and children, siblings, other family members, friends, coworkers, colleagues, or spouses.</mattext>
              </material>
            </response_label>
            <response_label ident="366">
              <material>
                <mattext texttype="text/plain">Acquaintances, neighbors, and distant relatives.</mattext>
              </material>
            </response_label>
            <response_label ident="2893">
              <material>
                <mattext texttype="text/plain">Social media followers and online gaming partners.</mattext>
              </material>
            </response_label>
            <response_label ident="6613">
              <material>
                <mattext texttype="text/plain">Individuals with shared hobbies in an informal setting.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">3433</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="3433_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">366</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="366_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">2893</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="2893_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">6613</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6613_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">3433</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="3433_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW109383081 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW109383081 BCX8"&gt;Explanation: Social wellness is strengthened by forming strong mutual attachments with others. These relationships could form between parents and children, siblings, other family members, friends, coworkers, colleagues, or spouses.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW109383081 BCX8" data-ccp-props="{}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="366_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW256731240 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW256731240 BCX8"&gt;While interactions with acquaintances, neighbors, and distant relatives can be part of social well-being, the provided text specifies strong mutual attachments for strengthening social wellness, listing parents and children, siblings, other family members, friends, coworkers, colleagues, or spouses as examples.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW256731240 BCX8" data-ccp-props="{}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="2893_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW44788386 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW44788386 BCX8"&gt;The provided text focuses on direct, mutual attachments for strengthening social wellness and does not mention social media followers or online gaming partners as examples of relationships that strengthen social wellness.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW44788386 BCX8" data-ccp-props="{}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="6613_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW100622251 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW100622251 BCX8"&gt;While shared hobbies can be a basis for relationships, the provided text emphasizes "strong mutual attachments" for strengthening social wellness and lists specific relationship types like family members, friends, coworkers, colleagues, or spouses.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW100622251 BCX8" data-ccp-props="{}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
