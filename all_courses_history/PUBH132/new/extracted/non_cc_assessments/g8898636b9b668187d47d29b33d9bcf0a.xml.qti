      <itemfeedback ident="1607_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW36880376 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW36880376 BCX8"&gt; Achieving academic honors is a personal achievement that is not a direct or universal benefit of having strong relationships, though social support can play an indirect role.  &lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW36880376 BCX8" data-ccp-props="{}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="7589_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW34580153 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW34580153 BCX8"&gt;Professional skills are typically developed through education, training, and work experience. While networking can be part of relationships, gaining professional skills is not the primary benefit mentioned for strong relationships in general. &lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW34580153 BCX8" data-ccp-props="{}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
