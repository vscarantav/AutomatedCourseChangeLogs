      <itemfeedback ident="1213_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW56596196 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW56596196 BCX8"&gt; While social wellness can contribute to physical health, the direct outcome of forming strong mutual attachments with others is the strengthening of one's social wellness.  &lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW56596196 BCX8" data-ccp-props="{}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="6151_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW247197182 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW247197182 BCX8"&gt; Spiritual wellness involves finding purpose and meaning in life and connecting to something greater than oneself, which is a separate dimension of wellness from forming mutual attachments.  &lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW247197182 BCX8" data-ccp-props="{}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="25_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW194406961 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW194406961 BCX8"&gt;Intellectual wellness involves engaging in creative and mentally stimulating activities and expanding knowledge, which is not directly strengthened by forming mutual attachments. &lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW194406961 BCX8" data-ccp-props="{}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gda47df7be298db9a65b53ad8f21e83f6" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>4191,5877,6130,2838</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW245253729 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW245253729 BCX8"&gt;What aspect of successful interpersonal relationships involves embracing others for who they are, including their imperfections? &lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW245253729 BCX8" data-ccp-props="{}"&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="4191">
              <material>
                <mattext texttype="text/plain">Acceptance</mattext>
              </material>
            </response_label>
            <response_label ident="5877">
              <material>
                <mattext texttype="text/plain">Appreciation</mattext>
              </material>
            </response_label>
            <response_label ident="6130">
              <material>
                <mattext texttype="text/plain">Tolerance</mattext>
              </material>
            </response_label>
            <response_label ident="2838">
              <material>
                <mattext texttype="text/plain">Shared values</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">5877</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="5877_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">6130</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6130_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">2838</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="2838_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">4191</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="5877_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW203391398 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW203391398 BCX8"&gt; Appreciation involves valuing and showing gratitude for others' positive qualities or actions, but acceptance specifically refers to embracing their entirety, including imperfections.  &lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW203391398 BCX8" data-ccp-props="{}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="6130_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW93624479 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW93624479 BCX8"&gt;Tolerance means enduring or putting up with differences, but acceptance goes a step further to truly embrace and value the individual despite their imperfections.  &lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW93624479 BCX8" data-ccp-props="{}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="2838_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW181200869 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW181200869 BCX8"&gt;Shared values refer to common beliefs, principles, or priorities that individuals hold, which is different from the act of embracing a person's individual characteristics and flaws. &lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW181200869 BCX8" data-ccp-props="{}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
