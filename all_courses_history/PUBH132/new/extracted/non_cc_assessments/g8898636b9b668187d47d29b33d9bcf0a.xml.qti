            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>3259,8545</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW33525766 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW33525766 BCX8"&gt;Tolerance in relationships means ignoring all differences and avoiding any disagreements. &lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW33525766 BCX8" data-ccp-props="{}"&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="3259">
              <material>
                <mattext texttype="text/plain">True</mattext>
              </material>
            </response_label>
            <response_label ident="8545">
              <material>
                <mattext texttype="text/plain">False</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">3259</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="3259_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">8545</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="3259_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW167007550 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW167007550 BCX8"&gt;This statement is false. Tolerance in relationships involves enduring and accepting differences and varying perspectives, rather than ignoring them or avoiding all disagreements. It means being willing to work through issues.  &lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW167007550 BCX8" data-ccp-props="{}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
