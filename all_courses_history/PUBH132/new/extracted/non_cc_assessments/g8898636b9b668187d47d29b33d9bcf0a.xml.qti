      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW167112907 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW167112907 BCX8"&gt;According to the course material, what is a key benefit of having strong relationships with family and friends? &lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW167112907 BCX8" data-ccp-props="{}"&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="8181">
              <material>
                <mattext texttype="text/plain">Reduced risk of getting sick</mattext>
              </material>
            </response_label>
            <response_label ident="4894">
              <material>
                <mattext texttype="text/plain">Increased financial wealth</mattext>
              </material>
            </response_label>
            <response_label ident="1607">
              <material>
                <mattext texttype="text/plain">Achieving academic honors</mattext>
              </material>
            </response_label>
            <response_label ident="7589">
              <material>
                <mattext texttype="text/plain">Gaining professional skills</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
