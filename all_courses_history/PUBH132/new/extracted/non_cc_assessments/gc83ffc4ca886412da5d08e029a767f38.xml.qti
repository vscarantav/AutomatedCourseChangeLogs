    <item ident="gfb114273a2b4b91641fa68df5c2bb3ee" title="Assignment Expectations">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>7477,6452,7689,5434</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;According to our text, what are the assignment expectations for this course?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="7477">
              <material>
                <mattext texttype="text/plain">Assignment questions should be answered in complete sentences.</mattext>
              </material>
            </response_label>
            <response_label ident="6452">
              <material>
                <mattext texttype="text/plain">Proper grammar, punctuation, and capitalization should be used in all assignments.</mattext>
              </material>
            </response_label>
            <response_label ident="7689">
              <material>
                <mattext texttype="text/plain">To earn full credit on assignments, you should include course content and personal examples.</mattext>
              </material>
            </response_label>
            <response_label ident="5434">
              <material>
                <mattext texttype="text/plain">All answers are correct.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">5434</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
