          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;div class="byui hs132"&gt;
&lt;p&gt;Which of the following is the &lt;strong&gt;most&lt;/strong&gt; appropriate method to lose 20 pounds?&lt;/p&gt;
&lt;/div&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="36762">
              <material>
                <mattext texttype="text/plain">Eliminate carbohydrate and increase protein intake.</mattext>
              </material>
            </response_label>
            <response_label ident="57267">
              <material>
                <mattext texttype="text/plain">Reduce caloric intake and increase caloric expenditure.</mattext>
              </material>
            </response_label>
            <response_label ident="36989">
              <material>
                <mattext texttype="text/plain">Decrease fat intake and increase carbohydrate intake.</mattext>
              </material>
            </response_label>
            <response_label ident="13178">
              <material>
                <mattext texttype="text/plain">Increase caloric expenditure and increase caloric intake.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">57267</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
