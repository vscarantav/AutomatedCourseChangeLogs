    <item ident="g56a77417da43f095db557212b1ad184c" title="Full credit example 4">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>0.5</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>6248,793,7939,3585</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span&gt;Identify a&amp;nbsp;&lt;/span&gt;&lt;strong&gt;specific&lt;/strong&gt;&lt;span&gt;&amp;nbsp;behavior or routine you can incorporate into your life to use technology in a healthy manner.&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="6248">
              <material>
                <mattext texttype="text/plain">I will put my phone away 1 hour before bedtime.</mattext>
              </material>
            </response_label>
            <response_label ident="793">
              <material>
                <mattext texttype="text/plain">I will use my phone less.</mattext>
              </material>
            </response_label>
            <response_label ident="7939">
              <material>
                <mattext texttype="text/plain">I tend to scroll on my phone before bed. This is a habit I want to change. I will turn my phone off by 9 pm every night to improve my sleep.</mattext>
              </material>
            </response_label>
            <response_label ident="3585">
              <material>
                <mattext texttype="text/plain">I spend a lot of time playing video games. I will play less video games.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">6248</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6248_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">793</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="793_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">7939</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="7939_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">3585</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="3585_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">7939</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="6248_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">You can make this answer more specific by identifying what time you will turn your phone off.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="793_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">This answer is not specific. How will you accomplish this?</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="7939_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">This answer provides a specific behavior you can follow.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="3585_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">This answer is not specific. How many hours will you play video games a day? Will you limit your video game playing to a specific day?</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
