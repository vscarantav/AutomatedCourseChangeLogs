                <mattext>Progressive muscle relaxation</mattext>
              </material>
            </response_label>
            <response_label ident="7464">
              <material>
                <mattext>Guided Imagery</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
        <response_lid ident="response_936">
          <material>
            <mattext texttype="text/plain">Process of contracting and then releasing muscles to allow built up tension to subside.</mattext>
          </material>
          <render_choice>
            <response_label ident="4224">
              <material>
                <mattext>Exercise</mattext>
              </material>
            </response_label>
            <response_label ident="6122">
              <material>
                <mattext>Progressive muscle relaxation</mattext>
              </material>
            </response_label>
            <response_label ident="7464">
              <material>
                <mattext>Guided Imagery</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
        <response_lid ident="response_22">
          <material>
            <mattext texttype="text/plain">Creates the same chemicals in the body as the fight or flight response.</mattext>
          </material>
          <render_choice>
            <response_label ident="4224">
              <material>
                <mattext>Exercise</mattext>
              </material>
            </response_label>
            <response_label ident="6122">
              <material>
                <mattext>Progressive muscle relaxation</mattext>
              </material>
            </response_label>
            <response_label ident="7464">
              <material>
                <mattext>Guided Imagery</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
        <response_lid ident="response_1406">
          <material>
            <mattext texttype="text/plain">A process of visualization and breathing.</mattext>
          </material>
          <render_choice>
            <response_label ident="4224">
              <material>
                <mattext>Exercise</mattext>
              </material>
            </response_label>
            <response_label ident="6122">
              <material>
                <mattext>Progressive muscle relaxation</mattext>
              </material>
            </response_label>
            <response_label ident="7464">
              <material>
                <mattext>Guided Imagery</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
        <response_lid ident="response_8588">
