      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;div class="byui hs132"&gt;
&lt;p&gt;Match the stress management technique with the correct description.&lt;/p&gt;
&lt;/div&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response_3246">
          <material>
            <mattext texttype="text/plain">Allows the user to increase adrenaline in a controlled environment and let the chemicals be used for a specific purpose.</mattext>
          </material>
          <render_choice>
            <response_label ident="4224">
              <material>
                <mattext>Exercise</mattext>
              </material>
            </response_label>
            <response_label ident="6122">
