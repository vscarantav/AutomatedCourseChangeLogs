      <item ident="ge0126d11eb98d4f8601706da3996dedd" title="WhatsApp">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>3484,5285,8149,9976</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>gf47b767d37e06559ff801f2d253307ba</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;&lt;span data-olk-copy-source="MessageBody"&gt;Starting in week 2, you will participate in a weekly WhatsApp discussion. Which of the following statements are true?&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="3484">
                <material>
                  <mattext texttype="text/plain">The WhatsApp discussion questions are found in the WhatsApp PUBH 132 announcements.</mattext>
                </material>
              </response_label>
              <response_label ident="5285">
                <material>
                  <mattext texttype="text/plain">During week 2-6, include a screenshot of your WhatsApp post in the word document (30 point assignment).</mattext>
                </material>
              </response_label>
              <response_label ident="8149">
                <material>
                  <mattext texttype="text/plain">Wait to submit your 30 point assignments until you have participated in the WhatsApp discussion for that specific week.</mattext>
                </material>
              </response_label>
              <response_label ident="9976">
                <material>
                  <mattext texttype="text/plain">All answers are correct.</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">9976</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
