      <item ident="g2e1a4f85c735cf9d0b23a2c2fce6d8f6" title="Academic Honesty">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>473,291</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>gf47b767d37e06559ff801f2d253307ba</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;div class="byui tesol101"&gt;
&lt;div style="border: 6px solid #376070; padding: 5px;"&gt;
&lt;div style="float: right; color: #fae5c3; font-size: 26px; margin-left: 5px; padding: 5px; background-color: #286177;"&gt;Honor&lt;/div&gt;
&lt;h2&gt;Academic Honesty&lt;/h2&gt;
&lt;p&gt;Students taking courses through BYU-Idaho are expected to follow BYU-Idaho's &lt;a class="inline_disabled" href="https://www.byui.edu/student-honor-office/academic-honesty" target="_blank"&gt;Academic Honesty policy.&lt;/a&gt; This includes avoiding plagiarism, fabrication or falsification, cheating, academic misconduct, and unauthorized uploading or sharing. BYU-Idaho takes academic honesty seriously and violations of the Academic Honesty Policy may result in consequences up to and including suspension or expulsion from the university.&amp;nbsp;&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;&lt;span&gt;I read the &lt;a class="inline_disabled" href="https://www.byui.edu/student-honor-office/academic-honesty" target="_blank"&gt;Academic Honesty policy&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="473">
                <material>
                  <mattext texttype="text/plain">Yes</mattext>
                </material>
              </response_label>
              <response_label ident="291">
                <material>
                  <mattext texttype="text/plain">No</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">473</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="g7eb075337f2e15c46edc1234f77cf152" title="Honor Code">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>2490,7976</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>ge6b23237d5915354ce181cd5ab92fefd</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;I can use Grammarly or artificial intelligence tools such as ChatGPT, Google Gemini, Claude, or Microsoft Copilot in activities &lt;em&gt;only as instructed&lt;/em&gt;.&amp;nbsp; I understand that if I use these tools inappropriately, my name will be reported to the Honor Code Office within the Wellness Department at BYU‑Pathway.&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="2490">
                <material>
                  <mattext texttype="text/plain">Yes</mattext>
                </material>
              </response_label>
              <response_label ident="7976">
                <material>
                  <mattext texttype="text/plain">No</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="Yes">
            <conditionvar>
              <varequal respident="response1">2490</varequal>
            </conditionvar>
            <displayfeedback feedbacktype="Response" linkrefid="2490_fb"/>
          </respcondition>
          <respcondition continue="Yes">
            <conditionvar>
              <varequal respident="response1">7976</varequal>
            </conditionvar>
            <displayfeedback feedbacktype="Response" linkrefid="7976_fb"/>
          </respcondition>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">2490</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
        <itemfeedback ident="2490_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/html">Google and Microsoft Docs have grammar and spelling check. Do not use Grammarly or artificial intelligence tools to improve your writing. We want to hear your voice and ideas.</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
        <itemfeedback ident="7976_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/html">Google and Microsoft Docs have grammar and spelling check. Do not use Grammarly or artificial intelligence tools to improve your writing. We want to hear your voice and ideas.</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>
