  <assessment ident="g501f7ea50eb181726b22d970a94376fa" title="W01 Quiz: WhatsApp ">
    <qtimetadata>
      <qtimetadatafield>
        <fieldlabel>cc_maxattempts</fieldlabel>
        <fieldentry>2</fieldentry>
      </qtimetadatafield>
    </qtimetadata>
    <section ident="root_section">
      <item ident="g32e3cd5e50a87328261c08d64f2ea694" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>2641,2559</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>gf47b767d37e06559ff801f2d253307ba</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;I have downloaded WhatsApp.&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="2641">
                <material>
                  <mattext texttype="text/plain">Yes</mattext>
                </material>
              </response_label>
              <response_label ident="2559">
                <material>
                  <mattext texttype="text/plain">No</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="Yes">
            <conditionvar>
              <varequal respident="response1">2641</varequal>
            </conditionvar>
            <displayfeedback feedbacktype="Response" linkrefid="2641_fb"/>
          </respcondition>
          <respcondition continue="Yes">
            <conditionvar>
              <varequal respident="response1">2559</varequal>
            </conditionvar>
            <displayfeedback feedbacktype="Response" linkrefid="2559_fb"/>
          </respcondition>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">2641</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
        <itemfeedback ident="2641_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/plain">Good job.</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
        <itemfeedback ident="2559_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/plain">Please stop here and follow the instructions before attempting to complete this quiz.</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>
