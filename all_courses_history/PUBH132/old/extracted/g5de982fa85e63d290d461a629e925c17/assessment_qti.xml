        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;div class="byui tesol101"&gt;
&lt;div style="border: 6px solid #376070; padding: 5px;"&gt;
&lt;div style="float: right; color: #fae5c3; font-size: 26px; margin-left: 5px; padding: 5px; background-color: #286177;"&gt;Honor&lt;/div&gt;
&lt;h2&gt;Academic Honesty&lt;/h2&gt;
&lt;p&gt;Students taking courses through BYU-Idaho are expected to follow BYU-Idaho's &lt;a class="inline_disabled" href="https://www.byui.edu/student-honor-office/academic-honesty" target="_blank"&gt;Academic Honesty policy.&lt;/a&gt; This includes avoiding plagiarism, fabrication or falsification, cheating, academic misconduct, and unauthorized uploading or sharing. BYU-Idaho takes academic honesty seriously and violations of the Academic Honesty Policy may result in consequences up to and including suspension or expulsion from the university.&amp;nbsp;&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;&lt;span&gt;I read the &lt;a class="inline_disabled" href="https://www.byui.edu/student-honor-office/academic-honesty" target="_blank"&gt;Academic Honesty policy&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="473">
                <material>
                  <mattext texttype="text/plain">Yes</mattext>
                </material>
              </response_label>
              <response_label ident="291">
                <material>
                  <mattext texttype="text/plain">No</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
