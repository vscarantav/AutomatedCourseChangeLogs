    <item ident="g3f58fabee9e4d1be7b7242aa513b04a9" title="AI1">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_answers_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>5287,3872,1013,1971</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span&gt;According to our text, what principles should guide our use of AI? (Mark all correct answers)&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Multiple">
          <render_choice>
            <response_label ident="5287">
              <material>
                <mattext texttype="text/plain">Avoid using AI when it prevents our growth and learning.</mattext>
              </material>
            </response_label>
            <response_label ident="3872">
              <material>
                <mattext texttype="text/plain">Avoid using AI when it robs you of human experience.</mattext>
              </material>
            </response_label>
            <response_label ident="1013">
              <material>
                <mattext texttype="text/plain">Avoid using AI when it breaks trust or undermines relationships.</mattext>
              </material>
            </response_label>
            <response_label ident="1971">
              <material>
                <mattext texttype="text/plain">Avoid using AI to brainstorm or explore ideas.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <and>
              <varequal respident="response1">5287</varequal>
              <varequal respident="response1">3872</varequal>
              <varequal respident="response1">1013</varequal>
              <not>
                <varequal respident="response1">1971</varequal>
              </not>
            </and>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
    <item ident="g4ae1cb60231dba158cad63a0651ac0b2" title="AI1">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_answers_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>5287,3872,1013,8987,1971</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span&gt;According to our text, what are three principles we should use to guide our us of AI? (Mark all correct answers)&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Multiple">
          <render_choice>
            <response_label ident="5287">
              <material>
                <mattext texttype="text/plain">Avoid using AI when it prevents our growth and learning.</mattext>
              </material>
            </response_label>
            <response_label ident="3872">
              <material>
                <mattext texttype="text/plain">Avoid using AI when it robs you of human experience.</mattext>
              </material>
            </response_label>
            <response_label ident="1013">
              <material>
                <mattext texttype="text/plain">Avoid using AI when it breaks trust or undermines relationships.</mattext>
              </material>
            </response_label>
            <response_label ident="8987">
              <material>
                <mattext texttype="text/plain">Avoid using AI when you can get caught for plagiarism.</mattext>
              </material>
            </response_label>
            <response_label ident="1971">
              <material>
                <mattext texttype="text/plain">Avoid using AI to brainstorm or explore ideas.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <and>
              <varequal respident="response1">5287</varequal>
              <varequal respident="response1">3872</varequal>
              <varequal respident="response1">1013</varequal>
              <not>
                <varequal respident="response1">8987</varequal>
              </not>
              <not>
                <varequal respident="response1">1971</varequal>
              </not>
            </and>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
