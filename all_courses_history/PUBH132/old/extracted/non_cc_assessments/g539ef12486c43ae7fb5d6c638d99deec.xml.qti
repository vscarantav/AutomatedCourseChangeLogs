    <item ident="g875a3a45bf7afacc588bb0d26099847e" title="Full credit example 2">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>2636,5518,1022</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Select the full credit answer to this question:&lt;/p&gt;
&lt;p&gt;&lt;span&gt;What type of relaxation technique did you try? Describe your experience.&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="2636">
              <material>
                <mattext texttype="text/plain">I did visualization and breathing exercises after my workout cool down. I laid on the mat with the lights off in my gym. It was a great experience to focus on my breathing. I also focused on my blessings. Afterwards, I felt more connected to my body and had a positive attitude.</mattext>
              </material>
            </response_label>
            <response_label ident="5518">
              <material>
                <mattext texttype="text/plain">I did deep breathing. Stress management is necessary for a holistic approach to wellness.</mattext>
              </material>
            </response_label>
            <response_label ident="1022">
              <material>
                <mattext texttype="text/plain">I practiced meditation.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">2636</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
