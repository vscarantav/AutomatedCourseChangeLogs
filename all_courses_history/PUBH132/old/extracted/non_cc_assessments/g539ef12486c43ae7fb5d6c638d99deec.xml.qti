          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>7477,6452,7689,5434</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;According to our text, what are the assignment expectations for this course? (Mark all correct answers)&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="7477">
              <material>
                <mattext texttype="text/plain">Assignment questions should be answered in complete sentences.</mattext>
              </material>
            </response_label>
            <response_label ident="6452">
              <material>
                <mattext texttype="text/plain">Proper grammar, punctuation, and capitalization should be used in all assignments.</mattext>
              </material>
            </response_label>
            <response_label ident="7689">
              <material>
                <mattext texttype="text/plain">To earn full credit on assignments and assessments, you should include course content and personal examples.</mattext>
              </material>
            </response_label>
            <response_label ident="5434">
              <material>
                <mattext texttype="text/plain">All answers are correct.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">6452</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
    <item ident="gb167e0d8fb5ee85af835712831725ab8" title="Canvas notification">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>true_false_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>459,2421</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;ol&gt;
&lt;li&gt;&lt;a class="inline_disabled" href="https://community.canvaslms.com/t5/Student-Guide/How-do-I-add-contact-methods-to-receive-Canvas-notifications-as/ta-p/516" target="_blank"&gt;Add your contact methods in Canvas&lt;/a&gt; so you can receive notifications, in your preferred delivery (text or email).&lt;/li&gt;
&lt;li&gt;&lt;a class="inline_disabled" href="https://community.instructure.com/en/kb/articles/662894-how-do-i-manage-my-canvas-notification-settings?utm_source=community-search&amp;amp;utm_medium=organic-search&amp;amp;utm_term=Set+your+notification+preferences+in+Canvas" target="_blank"&gt;Set your notification preferences in Canvas&lt;/a&gt; so you can be updated whenever there is a new announcement, comment or grade on your assignment, discussion update, etc.&amp;nbsp;&lt;/li&gt;
&lt;/ol&gt;
&lt;p&gt;Image Explanation&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;The green bell means you will be notified immediately.&lt;/li&gt;
&lt;li&gt;The green page means you will be notified at the end of the day.&lt;/li&gt;
&lt;li&gt;&lt;span&gt;The green calendar means you will be notified at the end of the week.&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;The white bell means you do not want this notification.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;img id="6942903" src="$IMS-CC-FILEBASE$/assessment_questions/W01%20Quiz_%20Syllabus%20&amp;amp;%20Steps%20for%20Success-scavengerHuntEmail.JPG?canvas_download=1" alt="W01 Quiz_ Syllabus &amp;amp; Steps for Success-scavengerHuntEmail.JPG" width="350" loading="lazy"&gt;&lt;/p&gt;
&lt;p&gt;T/F: I can set notifications individually for each course.&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="459">
              <material>
                <mattext texttype="text/plain">True</mattext>
              </material>
            </response_label>
            <response_label ident="2421">
              <material>
                <mattext texttype="text/plain">False</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">459</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
