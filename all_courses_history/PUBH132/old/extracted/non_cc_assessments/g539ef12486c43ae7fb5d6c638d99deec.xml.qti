    <item ident="g2c99054990d24cc76381707f74222aef" title="Full credit example 1">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>8376,2600,9242</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Select the full credit answer to this question:&lt;/p&gt;
&lt;p&gt;&lt;span&gt;H&lt;/span&gt;&lt;span&gt;ow can you be an example of physical wellness to your family or friends?&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="8376">
              <material>
                <mattext texttype="text/plain">inspiring them to invest in fitness classes and also follow healthy eating habits</mattext>
              </material>
            </response_label>
            <response_label ident="2600">
              <material>
                <mattext texttype="text/html">I have been sending videos and pictures of my workouts to my sister and family. I share links of my favorite workouts on YouTube. I'm always trying healthy recipes. If I find a healthy recipe, I share it with my friends. I hope that this encourages my family and friends to be healthier.</mattext>
              </material>
            </response_label>
            <response_label ident="9242">
              <material>
                <mattext texttype="text/plain">By adopting healthy habits and behaviors, people can positively impact their social communities and take care of their physical health.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">2600</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
