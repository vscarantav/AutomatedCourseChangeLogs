&lt;p&gt;&lt;span&gt;H&lt;/span&gt;&lt;span&gt;ow can you be an example of physical wellness to your family or friends?&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="8376">
              <material>
                <mattext texttype="text/plain">inspiring them to invest in fitness classes and also follow stable eating habits</mattext>
              </material>
            </response_label>
            <response_label ident="2600">
              <material>
                <mattext texttype="text/plain">I have been sending videos and pictures before and after my workouts to my sister and my family. I also like sending links to the workouts I do on YouTube. I also like sending healthy recipes to my friends.</mattext>
              </material>
            </response_label>
            <response_label ident="9242">
