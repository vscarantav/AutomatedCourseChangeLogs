      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW6414869 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW6414869 BCX8"&gt;What is a characteristic of a healthy spiritual ritual or practice?&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW6414869 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="3004">
              <material>
                <mattext texttype="text/plain">The energy involved is directed toward an experience or activity.</mattext>
              </material>
            </response_label>
            <response_label ident="1927">
              <material>
                <mattext texttype="text/plain">It is passively observed.</mattext>
              </material>
            </response_label>
            <response_label ident="9454">
              <material>
                <mattext texttype="text/plain">It guarantees immediate results.</mattext>
              </material>
