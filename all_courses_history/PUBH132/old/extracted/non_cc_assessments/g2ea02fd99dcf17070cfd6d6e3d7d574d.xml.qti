            <varequal respident="response1">7720</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="7720_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">3424</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="6882_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW126576115 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW126576115 BCX8"&gt;World religions typically focus on spiritual or divine explanations, not solely scientific ones.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW126576115 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
