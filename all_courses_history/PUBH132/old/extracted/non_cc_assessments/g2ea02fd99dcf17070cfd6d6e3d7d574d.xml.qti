                <mattext texttype="text/plain">How a person deals with ambiguity, the unexplained, and the uncertainty of life.</mattext>
              </material>
            </response_label>
            <response_label ident="8915">
              <material>
                <mattext texttype="text/plain">Solving detective novels.</mattext>
