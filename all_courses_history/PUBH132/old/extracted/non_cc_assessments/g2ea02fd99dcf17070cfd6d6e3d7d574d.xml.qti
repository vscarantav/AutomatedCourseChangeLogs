      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW193937614 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW193937614 BCX8"&gt;What is "hope" in spiritual wellness described as an experience of?&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW193937614 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="668">
              <material>
                <mattext texttype="text/plain">Ultimately feeling safe in life.</mattext>
