    <item ident="g22bd81c33c3f722e86a46ee5357c23fb" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>1609,6129,2223</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW254411118 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW254411118 BCX8"&gt;What is one characteristic that distinguishes spiritual wellness from faith or religiousness?&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW254411118 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="1609">
              <material>
                <mattext texttype="text/plain">Spiritual wellness can be achieved by people who do not adhere to a particular religion.</mattext>
              </material>
            </response_label>
            <response_label ident="6129">
              <material>
                <mattext texttype="text/plain">Spiritual wellness requires strict obedience to gospel principles.</mattext>
              </material>
            </response_label>
            <response_label ident="2223">
              <material>
                <mattext texttype="text/plain">Spiritual wellness is primarily about following a specific religious doctrine.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">6129</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6129_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">2223</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="2223_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">1609</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="6129_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW197464979 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW197464979 BCX8"&gt;Spiritual wellness does not require strict obedience to gospel principles, as it can be achieved by individuals regardless of their religious adherence.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW197464979 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="2223_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW266135436 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW266135436 BCX8"&gt;Spiritual wellness is not primarily about following a specific religious doctrine; it encompasses broader personal values and meaning.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW266135436 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g54dc42454f81c9160eba46aa6cb367cb" title="Question">
      <itemmetadata>
