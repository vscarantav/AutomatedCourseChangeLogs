      </itemfeedback>
      <itemfeedback ident="7720_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW149257420 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW149257420 BCX8"&gt;The content does not &lt;/span&gt;&lt;span class="NormalTextRun SCXW149257420 BCX8"&gt;state&lt;/span&gt;&lt;span class="NormalTextRun SCXW149257420 BCX8"&gt; that world religions emphasize material wealth.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW149257420 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
