          <render_choice>
            <response_label ident="3538">
              <material>
                <mattext texttype="text/plain">Other people, God or things considered divine, and elements in the environment.</mattext>
              </material>
            </response_label>
            <response_label ident="8322">
              <material>
                <mattext texttype="text/plain">Only with family members.</mattext>
              </material>
            </response_label>
            <response_label ident="3641">
              <material>
                <mattext texttype="text/plain">Only within religious organizations.</mattext>
              </material>
