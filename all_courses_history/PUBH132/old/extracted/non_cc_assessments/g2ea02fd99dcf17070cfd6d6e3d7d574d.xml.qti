          <render_choice>
            <response_label ident="3424">
              <material>
                <mattext texttype="text/plain">higher being or something greater than ourselves.</mattext>
              </material>
            </response_label>
            <response_label ident="6882">
              <material>
                <mattext texttype="text/plain">Scientific explanations for all life's questions.</mattext>
              </material>
            </response_label>
            <response_label ident="7720">
              <material>
                <mattext texttype="text/plain">The importance of material wealth.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
