            <mattext texttype="text/html">&lt;span class="TextRun SCXW212606070 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW212606070 BCX8"&gt;A healthy ritual is described as proactive, not passive.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW212606070 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
