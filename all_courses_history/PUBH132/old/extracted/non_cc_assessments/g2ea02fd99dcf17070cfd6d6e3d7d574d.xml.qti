            <response_label ident="2529">
              <material>
                <mattext texttype="text/plain">An interest in increasing knowledge in oneself and of things perceived as external.</mattext>
              </material>
            </response_label>
            <response_label ident="5920">
              <material>
                <mattext texttype="text/plain">Memorizing facts and figures.</mattext>
              </material>
            </response_label>
