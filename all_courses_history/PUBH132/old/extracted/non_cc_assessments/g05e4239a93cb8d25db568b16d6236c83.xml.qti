          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;&lt;span class="TextRun SCXW11645320 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW11645320 BCX8" data-ccp-parastyle="Normal (Web)"&gt;What does the acronym FAST refer to in the context of health?&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="5629">
              <material>
                <mattext texttype="text/plain">Symptoms of a stroke.</mattext>
              </material>
            </response_label>
            <response_label ident="4341">
              <material>
                <mattext texttype="text/plain">Steps for healthy eating</mattext>
              </material>
            </response_label>
            <response_label ident="1435">
              <material>
                <mattext texttype="text/plain">First aid for choking</mattext>
              </material>
            </response_label>
            <response_label ident="6154">
              <material>
                <mattext texttype="text/plain">How to quickly lose weight</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
