      <itemfeedback ident="5470_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW67608240 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW67608240 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Fish (especially white fish and many types of seafood) and skinless poultry are generally considered lean meat options due to their lower saturated fat content compared to many red meats.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW67608240 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
