      <itemfeedback ident="4204_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW203188976 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW203188976 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Atherosclerosis is a specific condition characterized by the accumulation of fatty deposits, cholesterol, cellular waste products, calcium, and fibrin (plaque) on the inner lining of arteries, leading to narrowing and hardening.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW203188976 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="958_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW227777397 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW227777397 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This is a common symptom of a stroke, which is often &lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXW227777397 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW227777397 BCX8" data-ccp-parastyle="Normal (Web)"&gt;caused&lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXW227777397 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW227777397 BCX8" data-ccp-parastyle="Normal (Web)"&gt; by atherosclerosis, but it is not atherosclerosis itself.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW227777397 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="3885_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW141411944 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW141411944 BCX8" data-ccp-parastyle="Normal (Web)"&gt; This describes heart failure, which can be a &lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXW141411944 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW141411944 BCX8" data-ccp-parastyle="Normal (Web)"&gt;consequence&lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXW141411944 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW141411944 BCX8" data-ccp-parastyle="Normal (Web)"&gt; of atherosclerosis but is not the definition of atherosclerosis itself.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW141411944 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="8034_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW108703847 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW108703847 BCX8" data-ccp-parastyle="Normal (Web)"&gt;While calcification can occur in atherosclerosis and contribute to hardening, the primary definition of atherosclerosis specifically refers to plaque buildup, which includes more than just calcium.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW108703847 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
