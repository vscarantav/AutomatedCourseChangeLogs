            <varequal respident="response1">2295</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="2295_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">7406</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="7406_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">7491</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="7491_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">7452</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="7452_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">2295</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="2295_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW106697856 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW106697856 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Unexplained weight loss is one of the five early signs of cancer, as cancer cells can use up a lot of the body's energy.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW106697856 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="7406_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW216577878 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW216577878 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Cancer typically leads to appetite loss or changes, not a sudden increase.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW216577878 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="7491_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW60420321 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW60420321 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Cancer often causes fatigue, not an increase in energy.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW60420321 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="7452_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW132480713 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW132480713 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Changes in hair growth are not typically cited as early warning signs of cancer.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW132480713 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g2111a2998d03c2554f91bb3f1ba3d036" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>3140,1913,5172,6470</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW191963424 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW191963424 BCX8" data-ccp-parastyle="Normal (Web)"&gt;What is the recommended number of hours of sleep each night for most adults?&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="3140">
              <material>
                <mattext texttype="text/plain">6–9 hours.</mattext>
              </material>
            </response_label>
            <response_label ident="1913">
              <material>
                <mattext texttype="text/plain">3–5 hours</mattext>
              </material>
            </response_label>
            <response_label ident="5172">
              <material>
                <mattext texttype="text/plain">10–12 hours</mattext>
              </material>
            </response_label>
            <response_label ident="6470">
              <material>
                <mattext texttype="text/plain">Less than 3 hours</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
