      <itemfeedback ident="5367_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW155348333 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW155348333 BCX8" data-ccp-parastyle="Normal (Web)"&gt;White bread is made from refined grains, which have most of their fiber removed.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW155348333 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
