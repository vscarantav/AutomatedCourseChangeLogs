          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="4307_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW227900406 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW227900406 BCX8" data-ccp-parastyle="Normal (Web)"&gt;High blood pressure (hypertension) is a major risk factor for stroke, but it can be managed and controlled through lifestyle changes (diet, exercise) and medication.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW227900406 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9504_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW54589987 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW54589987 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Age is a non-modifiable risk factor; the risk of stroke increases with age.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW54589987 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="8844_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW226068157 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW226068157 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Certain racial and ethnic groups have a higher risk of stroke, which is a non-modifiable factor.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW226068157 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9793_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW255054846 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW255054846 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Genetic predisposition or shared environmental factors can increase risk, but family history itself cannot be changed.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW255054846 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g8b879a556455cba3ed857aef40810026" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>6939,6676,8849,6761</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW205984246 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW205984246 BCX8" data-ccp-parastyle="Normal (Web)"&gt;What is the desired LDL (low-density lipoprotein or "bad" cholesterol) level? &lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="6939">
              <material>
                <mattext texttype="text/plain">Less than 100 mg/dL</mattext>
              </material>
            </response_label>
            <response_label ident="6676">
              <material>
                <mattext texttype="text/plain">100-129 mg/dL</mattext>
              </material>
            </response_label>
            <response_label ident="8849">
              <material>
                <mattext texttype="text/plain">130-159 mg/dL</mattext>
              </material>
            </response_label>
            <response_label ident="6761">
              <material>
                <mattext texttype="text/plain">190 mg/dL or higher</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
