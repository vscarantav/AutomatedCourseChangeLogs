          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="8298_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW60269007 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW60269007 BCX8" data-ccp-parastyle="Normal (Web)"&gt;While a headache can occur with heart problems, a sudden, severe "thunderclap" headache is a hallmark symptom of some types of stroke or other neurological issues, not typically a heart attack.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW60269007 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
