    <item ident="g213ee2aaac1ba8f91e14e5963737d255" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>281,5481,9352,193</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW222470302 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW222470302 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Which of the following scenarios would increase your daily hydration needs?&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="281">
              <material>
                <mattext texttype="text/plain">Exercising strenuously in a hot environment</mattext>
              </material>
            </response_label>
            <response_label ident="5481">
              <material>
                <mattext texttype="text/plain">Spending the day watching television</mattext>
              </material>
            </response_label>
            <response_label ident="9352">
              <material>
                <mattext texttype="text/plain">Being in a cold, dry indoor environment</mattext>
              </material>
            </response_label>
            <response_label ident="193">
              <material>
                <mattext texttype="text/plain">Eating a diet high in water-rich fruits and vegetables</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">281</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="281_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">5481</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="5481_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9352</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9352_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">193</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="193_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">281</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="281_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW139346641 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW139346641 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Strenuous physical activity, especially in hot conditions, leads to increased fluid loss through sweat, thereby increasing the body's need for hydration.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW139346641 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="5481_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW133104583 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW133104583 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This is a sedentary activity that does not significantly increase fluid loss.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW133104583 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9352_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW73164546 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW73164546 BCX8" data-ccp-parastyle="Normal (Web)"&gt;While dry air can cause some fluid loss, a cold environment itself does not increase hydration needs as dramatically as heat or strenuous exercise.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW73164546 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="193_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW73164546 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW73164546 BCX8" data-ccp-parastyle="Normal (Web)"&gt;While dry air can cause some fluid loss, a cold environment itself does not increase hydration needs as dramatically as heat or strenuous exercise.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW73164546 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g6ffd0b4113a201a28e4665e7f0a4a76b" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>6401,9955,5083,736</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW43522046 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW43522046 BCX8" data-ccp-parastyle="Normal (Web)"&gt;What is a primary purpose of protein in the human body?&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="6401">
              <material>
                <mattext texttype="text/plain">Building and repairing tissues</mattext>
              </material>
            </response_label>
            <response_label ident="9955">
              <material>
                <mattext texttype="text/plain">Providing the main source of immediate energy</mattext>
              </material>
            </response_label>
            <response_label ident="5083">
              <material>
                <mattext texttype="text/plain">Storing excess calories for long-term energy</mattext>
              </material>
            </response_label>
            <response_label ident="736">
              <material>
                <mattext texttype="text/plain">Regulating body temperature only</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">6401</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6401_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9955</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9955_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">5083</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="5083_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">736</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="736_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">6401</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="6401_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW202604453 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW202604453 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Protein is fundamental for the growth, maintenance, and repair of all body tissues, including muscles, organs, skin, and hair.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW202604453 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9955_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW15125037 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW15125037 BCX8" data-ccp-parastyle="Normal (Web)"&gt;While protein can be used for energy, carbohydrates are the body's main immediate fuel source.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW15125037 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="5083_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW177620392 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW177620392 BCX8" data-ccp-parastyle="Normal (Web)"&gt; Fats are the primary macronutrient used for long-term energy storage.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW177620392 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="736_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW245086809 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW245086809 BCX8" data-ccp-parastyle="Normal (Web)"&gt;While proteins (enzymes) are involved in metabolic processes that produce heat, water and fat are more directly involved in overall temperature regulation. Protein's role is much broader.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW245086809 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gba2a0f0d91d376b690ce97e90c751f2b" title="Question">
