      </resprocessing>
      <itemfeedback ident="4626_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW153322751 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW153322751 BCX8" data-ccp-parastyle="Normal (Web)"&gt;A higher HDL level is desirable because HDL helps remove excess cholesterol from the arteries, transporting it back to the liver for removal, thus protecting against heart disease. 60 mg/dL and above is considered protective.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW153322751 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="6582_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW156995854 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW156995854 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This is considered a major risk factor for heart disease.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW156995854 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="186_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW25132145 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW25132145 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This is acceptable but not considered optimal or protective.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW25132145 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
