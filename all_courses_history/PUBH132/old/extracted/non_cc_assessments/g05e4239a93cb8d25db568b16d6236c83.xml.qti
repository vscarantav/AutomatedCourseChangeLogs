    <item ident="gd011c986bfeabcd46175e02ddc77cc25" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>7125,2621,9718,2379</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW93574069 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW93574069 BCX8" data-ccp-parastyle="Normal (Web)"&gt;What is the definition of a benign neoplasm? &lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="7125">
              <material>
                <mattext texttype="text/plain">A mass of cells that does not spread to other parts of the body.</mattext>
              </material>
            </response_label>
            <response_label ident="2621">
              <material>
                <mattext texttype="text/plain">A cancerous tumor that grows rapidly</mattext>
              </material>
            </response_label>
            <response_label ident="9718">
              <material>
                <mattext texttype="text/plain">A mass of cells that always becomes malignant</mattext>
              </material>
            </response_label>
            <response_label ident="2379">
              <material>
                <mattext texttype="text/plain">A healthy mass of cells that performs normal functions</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">7125</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="7125_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">2621</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="2621_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9718</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9718_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">2379</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="2379_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">7125</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="7125_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW192699775 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW192699775 BCX8" data-ccp-parastyle="Normal (Web)"&gt;A benign neoplasm (tumor) is a non-cancerous growth that may increase in size but does not invade surrounding tissues or metastasize to distant sites.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW192699775 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="2621_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW182186382 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW182186382 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This describes a characteristic of a malignant (cancerous) tumor.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW182186382 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9718_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW18609278 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW18609278 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Benign neoplasms typically remain benign and do not necessarily become malignant.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW18609278 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="2379_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW130418706 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW130418706 BCX8" data-ccp-parastyle="Normal (Web)"&gt;A neoplasm, even benign, is an abnormal growth; healthy cells perform normal functions without forming an abnormal mass.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW130418706 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gf8e6bc4c4a822ba3266353de98b6cdf3" title="Question">
