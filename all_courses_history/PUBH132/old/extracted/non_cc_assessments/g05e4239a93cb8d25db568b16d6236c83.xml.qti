      <itemfeedback ident="6618_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW224380220 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW224380220 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Chest pain, pressure, tightness, or discomfort is the most common symptom of a heart attack, often radiating to other areas like the arm, back, neck, jaw, or stomach.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW224380220 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="6697_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW193366185 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW193366185 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This is a classic symptom of a stroke.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW193366185 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
