    <item ident="g4566d9ca67819c3adf6500077c4015fd" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>2412,7242,3723,3192</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW151136947 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW151136947 BCX8" data-ccp-parastyle="Normal (Web)"&gt;What does your body primarily do with unused energy from the food you eat?&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="2412">
              <material>
                <mattext texttype="text/plain">Stores it as complex glucose molecules or fat.</mattext>
              </material>
            </response_label>
            <response_label ident="7242">
              <material>
                <mattext texttype="text/plain">Expels it immediately</mattext>
              </material>
            </response_label>
            <response_label ident="3723">
              <material>
                <mattext texttype="text/plain">Converts it into essential vitamins</mattext>
              </material>
            </response_label>
            <response_label ident="3192">
              <material>
                <mattext texttype="text/plain">Uses it to build muscle mass only</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">2412</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="2412_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">7242</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="7242_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">3723</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="3723_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">3192</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="3192_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">2412</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="2412_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW1148137 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW1148137 BCX8" data-ccp-parastyle="Normal (Web)"&gt;When the body takes in more energy (calories) than it &lt;/span&gt;&lt;span class="NormalTextRun SCXW1148137 BCX8" data-ccp-parastyle="Normal (Web)"&gt;immediately&lt;/span&gt;&lt;span class="NormalTextRun SCXW1148137 BCX8" data-ccp-parastyle="Normal (Web)"&gt; needs, it converts the excess into glycogen (complex glucose molecules) for short-term storage in the liver and muscles, or into fat for long-term storage in adipose tissue.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW1148137 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="7242_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW137167993 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW137167993 BCX8" data-ccp-parastyle="Normal (Web)"&gt;The body is efficient at storing excess energy rather than expelling it; expelling &lt;/span&gt;&lt;span class="NormalTextRun SCXW137167993 BCX8" data-ccp-parastyle="Normal (Web)"&gt;large amounts&lt;/span&gt;&lt;span class="NormalTextRun SCXW137167993 BCX8" data-ccp-parastyle="Normal (Web)"&gt; of unused energy would be metabolically wasteful.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW137167993 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="3723_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW186036338 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW186036338 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Energy from food is not converted into vitamins; vitamins are micronutrients obtained from the diet or synthesized by the body in &lt;/span&gt;&lt;span class="NormalTextRun SCXW186036338 BCX8" data-ccp-parastyle="Normal (Web)"&gt;small amounts&lt;/span&gt;&lt;span class="NormalTextRun SCXW186036338 BCX8" data-ccp-parastyle="Normal (Web)"&gt;.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW186036338 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="3192_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW173773597 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW173773597 BCX8" data-ccp-parastyle="Normal (Web)"&gt;While excess energy can contribute to muscle growth (especially with resistance training and adequate protein), &lt;/span&gt;&lt;span class="NormalTextRun SCXW173773597 BCX8" data-ccp-parastyle="Normal (Web)"&gt;a significant portion&lt;/span&gt;&lt;span class="NormalTextRun SCXW173773597 BCX8" data-ccp-parastyle="Normal (Web)"&gt; is stored as fat, and &lt;/span&gt;&lt;span class="NormalTextRun SCXW173773597 BCX8" data-ccp-parastyle="Normal (Web)"&gt;it's&lt;/span&gt;&lt;span class="NormalTextRun SCXW173773597 BCX8" data-ccp-parastyle="Normal (Web)"&gt; not &lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXW173773597 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW173773597 BCX8" data-ccp-parastyle="Normal (Web)"&gt;only&lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXW173773597 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW173773597 BCX8" data-ccp-parastyle="Normal (Web)"&gt; used for muscle mass.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW173773597 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
