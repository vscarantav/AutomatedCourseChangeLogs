      <itemfeedback ident="8363_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW245820694 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW245820694 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Modifiable risk factors are those that individuals can change or control through lifestyle choices or medical intervention. Smoking is a direct choice that significantly &lt;/span&gt;&lt;span class="NormalTextRun SCXW245820694 BCX8" data-ccp-parastyle="Normal (Web)"&gt;impacts&lt;/span&gt;&lt;span class="NormalTextRun SCXW245820694 BCX8" data-ccp-parastyle="Normal (Web)"&gt; heart health.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW245820694 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9247_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW84111267 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW84111267 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Age is a non-modifiable risk factor; it cannot be changed.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW84111267 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="7823_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW183680748 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW183680748 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Family history of heart disease is a non-modifiable risk factor, &lt;/span&gt;&lt;span class="NormalTextRun SCXW183680748 BCX8" data-ccp-parastyle="Normal (Web)"&gt;indicating&lt;/span&gt;&lt;span class="NormalTextRun SCXW183680748 BCX8" data-ccp-parastyle="Normal (Web)"&gt; a genetic predisposition.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW183680748 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
