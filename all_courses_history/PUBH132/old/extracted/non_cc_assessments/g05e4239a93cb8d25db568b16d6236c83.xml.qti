      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW114868106 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW114868106 BCX8" data-ccp-parastyle="Normal (Web)"&gt;True or False: All risk factors for heart disease are non-modifiable and cannot be changed.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="5018">
              <material>
                <mattext texttype="text/plain">True</mattext>
              </material>
            </response_label>
            <response_label ident="9204">
              <material>
                <mattext texttype="text/plain">False</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">5018</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="5018_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9204</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9204_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">9204</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="5018_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW16489798 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW16489798 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This is incorrect. If all risk factors were non-modifiable, prevention efforts would be futile, which is not the case.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW16489798 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9204_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW262478568 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW262478568 BCX8" data-ccp-parastyle="Normal (Web)"&gt;There are both modifiable (e.g., smoking, diet, physical activity, blood pressure) and non-modifiable (e.g., age, gender, genetics) risk factors for heart disease. Many significant risk factors &lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXW262478568 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW262478568 BCX8" data-ccp-parastyle="Normal (Web)"&gt;can&lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXW262478568 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW262478568 BCX8" data-ccp-parastyle="Normal (Web)"&gt; be changed or managed.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW262478568 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g36a6e0603570f3ad5754f5e4b83a4c6e" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>207,3579,3551,1892</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW187898065 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW187898065 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Which of the following is a common symptom of a stroke?&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="207">
              <material>
                <mattext texttype="text/plain">Sudden issues with vision, such as blurriness or loss of vision in one eye.</mattext>
              </material>
            </response_label>
            <response_label ident="3579">
              <material>
                <mattext texttype="text/plain">Persistent cough and fever</mattext>
              </material>
            </response_label>
            <response_label ident="3551">
              <material>
                <mattext texttype="text/plain">Sharp pain in the lower back</mattext>
              </material>
            </response_label>
            <response_label ident="1892">
              <material>
                <mattext texttype="text/plain">Gradual onset of widespread joint pain</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">207</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="207_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">3579</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="3579_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">3551</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="3551_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">1892</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="1892_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">207</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="207_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW151924569 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW151924569 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Vision changes, including sudden blurriness, double vision, or loss of vision in one or both eyes, are common neurological symptoms of a stroke, indicating an impact on the brain.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW151924569 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="3579_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW69268193 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW69268193 BCX8" data-ccp-parastyle="Normal (Web)"&gt;These are common symptoms of infections like the flu or pneumonia, not typically a stroke.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW69268193 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="3551_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW119213519 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW119213519 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This is a symptom of musculoskeletal issues, not a stroke.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW119213519 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="1892_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW56015482 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW56015482 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This is indicative of conditions like arthritis, not an acute stroke.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW56015482 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g63a5461acde57805667702428dfe7f61" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>4859,1962,1764,6072</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW98531424 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW98531424 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Which macronutrient is essential for proper growth and development, especially in children? &lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="4859">
              <material>
                <mattext texttype="text/plain">Fats.</mattext>
              </material>
            </response_label>
            <response_label ident="1962">
              <material>
                <mattext texttype="text/plain">Added sugars</mattext>
              </material>
            </response_label>
            <response_label ident="1764">
              <material>
                <mattext texttype="text/plain">Simple carbohydrates</mattext>
              </material>
            </response_label>
            <response_label ident="6072">
              <material>
                <mattext texttype="text/plain">Artificial sweeteners</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">4859</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="4859_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">1962</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="1962_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">1764</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="1764_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">6072</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6072_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">4859</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="4859_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW12746168 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW12746168 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Fats, particularly essential fatty acids, are crucial for proper growth and development, brain function, absorption of fat-soluble vitamins, and overall cellular health.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW12746168 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="1962_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW169738131 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW169738131 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Added sugars provide empty calories and contribute to health problems, not essential growth and development.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW169738131 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="1764_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW34872181 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW34872181 BCX8" data-ccp-parastyle="Normal (Web)"&gt;While carbohydrates provide energy, simple carbohydrates (sugars) lack the broader nutritional benefits for growth and development that fats and proteins offer.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW34872181 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="6072_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW85585633 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW85585633 BCX8" data-ccp-parastyle="Normal (Web)"&gt;These are non-caloric additives and do not contribute to growth or development.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW85585633 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g00cbefef67a86a7f237e060d81e549f9" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>3689,1461,5071,1734</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW225577405 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW225577405 BCX8" data-ccp-parastyle="Normal (Web)"&gt;What is the recommended percentage range of total calories that should come from fat?&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="3689">
              <material>
                <mattext texttype="text/plain">20–35%.</mattext>
              </material>
            </response_label>
            <response_label ident="1461">
              <material>
                <mattext texttype="text/plain">10–35%</mattext>
              </material>
            </response_label>
            <response_label ident="5071">
              <material>
                <mattext texttype="text/plain">45–65%</mattext>
              </material>
            </response_label>
            <response_label ident="1734">
              <material>
                <mattext texttype="text/plain">Less than 10%</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">3689</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="3689_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">1461</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="1461_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">5071</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="5071_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">1734</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="1734_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">3689</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="3689_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW264221973 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW264221973 BCX8" data-ccp-parastyle="Normal (Web)"&gt;The acceptable macronutrient distribution range (AMDR) for fat is typically 20–35% of total daily calories for adults, ensuring adequate intake of essential fatty acids and fat-soluble vitamins.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW264221973 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="1461_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW23521191 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW23521191 BCX8" data-ccp-parastyle="Normal (Web)"&gt;While 20-35% falls within this, 10-35% is the range for protein.&lt;/span&gt;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="5071_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW253186101 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW253186101 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This range is for carbohydrates.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW253186101 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="1734_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW52188467 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW52188467 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This is generally considered too low for healthy fat intake and can lead to deficiencies.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW52188467 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g913258afa50d8f0740be657e316bef34" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>1593,964,161,5883</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW27700783 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW27700783 BCX8" data-ccp-parastyle="Normal (Web)"&gt; What is the general relationship between a person's physical activity level and their carbohydrate needs? &lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="1593">
              <material>
                <mattext texttype="text/plain">More physically active people generally need more carbohydrates.</mattext>
              </material>
            </response_label>
            <response_label ident="964">
              <material>
                <mattext texttype="text/plain">More physically active people generally need fewer carbohydrates</mattext>
              </material>
            </response_label>
            <response_label ident="161">
              <material>
                <mattext texttype="text/plain">Physical activity has no impact on carbohydrate needs</mattext>
              </material>
            </response_label>
            <response_label ident="5883">
              <material>
                <mattext texttype="text/plain">Carbohydrate needs only change with protein intake</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">1593</varequal>
          </conditionvar>
