    <item ident="gcfef25540c037f4e1e6d0aab1f5001ed" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>5981,5982,6339,1528</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW68991648 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW68991648 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Which of the following is an essential function that water performs in the human body?&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="5981">
              <material>
                <mattext texttype="text/plain">Maintenance of blood volume</mattext>
              </material>
            </response_label>
            <response_label ident="5982">
              <material>
                <mattext texttype="text/plain">Absorption of fat-soluble vitamins only</mattext>
              </material>
            </response_label>
            <response_label ident="6339">
              <material>
                <mattext texttype="text/plain">Production of red blood cells</mattext>
              </material>
            </response_label>
            <response_label ident="1528">
              <material>
                <mattext texttype="text/plain">Breakdown of complex carbohydrates</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">5981</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="5981_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">5982</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="5982_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">6339</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6339_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">1528</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="1528_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">5981</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="5981_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW211939188 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW211939188 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Water is a primary component of blood and is crucial for maintaining adequate blood volume, which ensures proper circulation and nutrient delivery throughout the body.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW211939188 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="5982_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW192471937 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW192471937 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Water is involved in nutrient transport generally, but fat-soluble vitamins require fat for absorption. Water's role is not limited to this.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW192471937 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="6339_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW117906139 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW117906139 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Red blood cell production occurs in the bone marrow and requires nutrients like iron and B vitamins, not primarily water as a direct component of production.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW117906139 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="1528_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW91231420 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW91231420 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Enzymes break down carbohydrates during digestion. While water is part of the digestive environment, it doesn't directly perform the breakdown.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW91231420 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
