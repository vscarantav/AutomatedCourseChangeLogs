      <itemfeedback ident="2552_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW119831425 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW119831425 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Non-modifiable risk factors are aspects that cannot be changed. Gender is a biological factor that influences heart disease risk but cannot be altered.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW119831425 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
