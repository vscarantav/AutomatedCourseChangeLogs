        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">5629</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="5629_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;&lt;span class="TextRun SCXW238168430 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW238168430 BCX8" data-ccp-parastyle="Normal (Web)"&gt;FAST is a widely used acronym to help people remember and recognize the common signs and symptoms of a stroke: Face drooping, Arm weakness, Speech difficulty, Time to call emergency services.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW238168430 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="4341_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;&lt;span class="TextRun SCXW134016569 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW134016569 BCX8" data-ccp-parastyle="Normal (Web)"&gt;There is no common health acronym called FAST for healthy eating.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW134016569 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="1435_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;p&gt;&lt;span class="TextRun SCXW19057334 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW19057334 BCX8" data-ccp-parastyle="Normal (Web)"&gt; While first aid involves quick action, FAST is not the acronym used for choking.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW19057334 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="6154_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW64087035 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW64087035 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This acronym is unrelated to weight loss strategies.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW64087035 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g8002ab2b1dce18a6289512dce9e6f547" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>6033,8740,4614,2393</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW159673284 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW159673284 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Which type of diabetes is primarily characterized by the pancreas producing little or no insulin?&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="6033">
              <material>
                <mattext texttype="text/plain">Type 1 diabetes</mattext>
              </material>
            </response_label>
            <response_label ident="8740">
              <material>
                <mattext texttype="text/plain">Type 2 diabetes</mattext>
              </material>
            </response_label>
            <response_label ident="4614">
              <material>
                <mattext texttype="text/plain">Gestational diabetes</mattext>
              </material>
            </response_label>
            <response_label ident="2393">
              <material>
                <mattext texttype="text/plain">Prediabetes</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">6033</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6033_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">8740</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="8740_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">4614</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="4614_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">2393</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="2393_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">6033</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="6033_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW225362261 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW225362261 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Type 1 diabetes is an autoimmune condition where the body's immune system attacks and destroys the insulin-producing beta cells in the pancreas, leading to little or no insulin production.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW225362261 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="8740_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW24343645 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW24343645 BCX8" data-ccp-parastyle="Normal (Web)"&gt;In type 2 diabetes, the body either &lt;/span&gt;&lt;span class="NormalTextRun SCXW24343645 BCX8" data-ccp-parastyle="Normal (Web)"&gt;doesn't&lt;/span&gt;&lt;span class="NormalTextRun SCXW24343645 BCX8" data-ccp-parastyle="Normal (Web)"&gt; produce enough insulin or &lt;/span&gt;&lt;span class="NormalTextRun SCXW24343645 BCX8" data-ccp-parastyle="Normal (Web)"&gt;doesn't&lt;/span&gt;&lt;span class="NormalTextRun SCXW24343645 BCX8" data-ccp-parastyle="Normal (Web)"&gt; use insulin effectively (insulin resistance), but the pancreas usually still produces some insulin, at least initially.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW24343645 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="4614_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW11759330 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW11759330 BCX8" data-ccp-parastyle="Normal (Web)"&gt; This is a temporary form of diabetes that develops during pregnancy, where the body cannot make and use all the insulin it needs for pregnancy.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW11759330 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="2393_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW257196006 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW257196006 BCX8" data-ccp-parastyle="Normal (Web)"&gt; Prediabetes is a condition where blood sugar levels are higher than normal but not high enough yet to be diagnosed as type 2 diabetes.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW257196006 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gf37b397563e89f75bbf277b8c6d9e985" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
