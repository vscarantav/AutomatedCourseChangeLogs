          <conditionvar>
            <varequal respident="response1">5629</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="5629_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">4341</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="4341_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">1435</varequal>
