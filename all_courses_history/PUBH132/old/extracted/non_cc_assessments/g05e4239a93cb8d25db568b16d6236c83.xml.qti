        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW244646384 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW244646384 BCX8" data-ccp-parastyle="Normal (Web)"&gt;While a low LDL is desirable, total cholesterol includes HDL, and a level below &lt;/span&gt;&lt;span class="NormalTextRun AdvancedProofingIssueV2Themed SCXW244646384 BCX8" data-ccp-parastyle="Normal (Web)"&gt;100 mg&lt;/span&gt;&lt;span class="NormalTextRun SCXW244646384 BCX8" data-ccp-parastyle="Normal (Web)"&gt;/dL would be unusually low and not the standard "optimal" total cholesterol target.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW244646384 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gad52f35424f00e00de0664317dfcdaaa" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>5385,7056,1628,9106</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW160068341 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW160068341 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Which of the following is a way to lower high blood pressure? &lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="5385">
              <material>
                <mattext texttype="text/plain">Decrease salt intake.</mattext>
              </material>
            </response_label>
            <response_label ident="7056">
              <material>
                <mattext texttype="text/plain">Increase saturated fat intake</mattext>
              </material>
            </response_label>
            <response_label ident="1628">
              <material>
                <mattext texttype="text/plain">Reduce physical activity</mattext>
              </material>
            </response_label>
            <response_label ident="9106">
              <material>
                <mattext texttype="text/plain">Consume more processed foods</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">5385</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="5385_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">7056</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="7056_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">1628</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="1628_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9106</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9106_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">5385</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="5385_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW161535020 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW161535020 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Reducing sodium (salt) intake is a well-established dietary strategy to lower high blood pressure, as excessive sodium can cause the body to &lt;/span&gt;&lt;span class="NormalTextRun SCXW161535020 BCX8" data-ccp-parastyle="Normal (Web)"&gt;retain&lt;/span&gt;&lt;span class="NormalTextRun SCXW161535020 BCX8" data-ccp-parastyle="Normal (Web)"&gt; fluid, increasing blood volume and pressure.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW161535020 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="7056_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW49581501 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW49581501 BCX8" data-ccp-parastyle="Normal (Web)"&gt; Increasing saturated fat intake can negatively affect cholesterol levels and potentially blood pressure; it does not help lower high blood pressure.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW49581501 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="1628_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW42422420 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW42422420 BCX8" data-ccp-parastyle="Normal (Web)"&gt; Reducing physical activity typically contributes to higher blood pressure and worse cardiovascular health, rather than lowering blood pressure.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW42422420 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9106_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW184263459 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW184263459 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Processed foods are often high in sodium, unhealthy fats, and added sugars, all of which can contribute to high blood pressure and other health issues, not lower it.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW184263459 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g82b8f6be38cef867063bf5fc8a3db35c" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>9922,1125,1072,4809</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW264343111 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW264343111 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Which of the following is a significant risk factor for developing type 2 diabetes?&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="9922">
              <material>
                <mattext texttype="text/plain">Being overweight or obese</mattext>
              </material>
            </response_label>
            <response_label ident="1125">
              <material>
                <mattext texttype="text/plain">Regular intense exercise</mattext>
              </material>
            </response_label>
            <response_label ident="1072">
              <material>
                <mattext texttype="text/plain">Eating a diet rich in whole grains</mattext>
              </material>
            </response_label>
            <response_label ident="4809">
              <material>
                <mattext texttype="text/plain">Having no family history of diabetes</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9922</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9922_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">1125</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="1125_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">1072</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="1072_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">4809</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="4809_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">9922</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="9922_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW183026700 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW183026700 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Excess body weight, particularly around the abdomen, is a primary risk factor for insulin resistance, which can lead to type 2 diabetes.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW183026700 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="1125_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW14882079 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW14882079 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Regular exercise is a protective factor against type 2 diabetes, improving insulin sensitivity.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW14882079 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="1072_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW60161871 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW60161871 BCX8" data-ccp-parastyle="Normal (Web)"&gt;A diet rich in whole grains is associated with a &lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXW60161871 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW60161871 BCX8" data-ccp-parastyle="Normal (Web)"&gt;lower&lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXW60161871 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW60161871 BCX8" data-ccp-parastyle="Normal (Web)"&gt; risk of type 2 diabetes due to fiber content and better blood sugar control.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW60161871 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="4809_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW21150074 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW21150074 BCX8" data-ccp-parastyle="Normal (Web)"&gt;While family history is a risk factor, having no family history does not &lt;/span&gt;&lt;span class="NormalTextRun SCXW21150074 BCX8" data-ccp-parastyle="Normal (Web)"&gt;eliminate&lt;/span&gt;&lt;span class="NormalTextRun SCXW21150074 BCX8" data-ccp-parastyle="Normal (Web)"&gt; the risk, and lifestyle factors like weight remain crucial.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW21150074 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="ge73fe81a48aa96f2a6fb4cabca0fd78e" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>5401,2787,9617,8863</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW20679008 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW20679008 BCX8" data-ccp-parastyle="Normal (Web)"&gt;What happens when cancer cells metastasize? &lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="5401">
              <material>
                <mattext texttype="text/plain">They spread from their original site to other parts of the body.</mattext>
              </material>
            </response_label>
            <response_label ident="2787">
              <material>
                <mattext texttype="text/plain">They are repaired by the body's DNA replication sequence</mattext>
              </material>
            </response_label>
            <response_label ident="9617">
              <material>
                <mattext texttype="text/plain">They become benign and stop growing</mattext>
              </material>
            </response_label>
            <response_label ident="8863">
              <material>
                <mattext texttype="text/plain">They strengthen the immune system's response</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">5401</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="5401_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">2787</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="2787_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9617</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9617_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">8863</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="8863_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">5401</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="5401_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW16884966 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW16884966 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Metastasis is the process by which cancer cells detach from the primary tumor, travel through the bloodstream or lymphatic system, and form new tumors in distant organs or tissues.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW16884966 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="2787_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW141495441 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW141495441 BCX8" data-ccp-parastyle="Normal (Web)"&gt; The body's normal mechanisms &lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXW141495441 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW141495441 BCX8" data-ccp-parastyle="Normal (Web)"&gt;try&lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXW141495441 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW141495441 BCX8" data-ccp-parastyle="Normal (Web)"&gt; to repair DNA flaws, but metastasis occurs when these flawed cells &lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXW141495441 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW141495441 BCX8" data-ccp-parastyle="Normal (Web)"&gt;continue&lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXW141495441 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW141495441 BCX8" data-ccp-parastyle="Normal (Web)"&gt; to replicate abnormally and spread.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW141495441 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9617_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW19673971 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW19673971 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Benign neoplasms do not spread, but once cancer cells are malignant and metastasizing, they are spreading and continuing to grow in new locations, not becoming benign.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW19673971 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="8863_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW119458393 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW119458393 BCX8" data-ccp-parastyle="Normal (Web)"&gt;While the immune system may try to fight cancer, metastasizing cancer typically &lt;/span&gt;&lt;span class="NormalTextRun SCXW119458393 BCX8" data-ccp-parastyle="Normal (Web)"&gt;indicates&lt;/span&gt;&lt;span class="NormalTextRun SCXW119458393 BCX8" data-ccp-parastyle="Normal (Web)"&gt; that the immune system has not effectively controlled the spread, and the process of metastasis itself does not inherently strengthen the immune response.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW119458393 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g6a8c063698fdf7c7edf7a22d1559f33c" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>7220,5816,5858,289</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW99908500 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW99908500 BCX8" data-ccp-parastyle="Normal (Web)"&gt;What is the recommended daily intake of fruits and vegetables?&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="7220">
              <material>
                <mattext texttype="text/plain">5–9 servings.</mattext>
              </material>
            </response_label>
            <response_label ident="5816">
              <material>
                <mattext texttype="text/plain">1–2 servings</mattext>
              </material>
            </response_label>
            <response_label ident="5858">
              <material>
                <mattext texttype="text/plain">10–12 servings</mattext>
              </material>
            </response_label>
            <response_label ident="289">
              <material>
                <mattext texttype="text/plain">0 servings</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">7220</varequal>
