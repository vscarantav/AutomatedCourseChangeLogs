    <item ident="g1ff19caaf6cb2c6d7f1509769ce79265" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>true_false_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>8199,3430</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW117732781 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW117732781 BCX8" data-ccp-parastyle="Normal (Web)"&gt;True or False: Type 2 diabetes is often known as juvenile diabetes. &lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="8199">
              <material>
                <mattext texttype="text/plain">True</mattext>
              </material>
            </response_label>
            <response_label ident="3430">
              <material>
                <mattext texttype="text/plain">False</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">8199</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="8199_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">3430</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="3430_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">3430</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="8199_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW62669855 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW62669855 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This is incorrect. Type 1 is the form historically called juvenile diabetes.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW62669855 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="3430_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW24901620 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW24901620 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Type 1 diabetes (which often develops in children and young adults) was historically known as juvenile diabetes. Type 2 diabetes is more commonly diagnosed in adults, though its incidence is rising in younger populations.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW24901620 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g0ddb8690520658eb320b97b2f99a5c7d" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>9399,7738,6056,6480</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW106818680 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW106818680 BCX8" data-ccp-parastyle="Normal (Web)"&gt;In the CAUTION mnemonic for cancer warning signs, what does the letter 'C' stand for?&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="9399">
              <material>
                <mattext texttype="text/plain">Change in bowel or bladder habits</mattext>
              </material>
            </response_label>
            <response_label ident="7738">
              <material>
                <mattext texttype="text/plain">Cold or cough that won't go away</mattext>
              </material>
            </response_label>
            <response_label ident="6056">
              <material>
                <mattext texttype="text/plain">Chest pain</mattext>
              </material>
            </response_label>
            <response_label ident="6480">
              <material>
                <mattext texttype="text/plain">Color changes in skin</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9399</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9399_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">7738</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="7738_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">6056</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6056_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">6480</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6480_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">9399</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="9399_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW245795608 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW245795608 BCX8" data-ccp-parastyle="Normal (Web)"&gt;The "C" in CAUTION represents a significant or persistent change in bowel or bladder habits, which can be an early indicator of certain cancers.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW245795608 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="7738_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW175777382 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW175777382 BCX8" data-ccp-parastyle="Normal (Web)"&gt;While a nagging cough is part of the mnemonic ("N"), "C" specifically refers to bowel/bladder changes.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW175777382 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="6056_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW249212256 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW249212256 BCX8" data-ccp-parastyle="Normal (Web)"&gt; Chest pain is a symptom of heart issues, not typically a direct warning sign of cancer in this mnemonic.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW249212256 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="6480_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW28816501 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW28816501 BCX8" data-ccp-parastyle="Normal (Web)"&gt;While "obvious change in a mole" is part of the mnemonic ("O"), "C" does not refer to general skin color changes.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW28816501 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gf75c47c01fdcfeb1b3da57386db45b9c" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>9005,3450,8196,5843</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW235842296 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW235842296 BCX8" data-ccp-parastyle="Normal (Web)"&gt;What is the principle for maintaining your current body weight? &lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="9005">
              <material>
                <mattext texttype="text/plain">Calories consumed from food should equal calories used by the body.</mattext>
              </material>
            </response_label>
            <response_label ident="3450">
              <material>
                <mattext texttype="text/plain">Consume significantly more calories than you use</mattext>
              </material>
            </response_label>
            <response_label ident="8196">
              <material>
                <mattext texttype="text/plain">Consume significantly fewer calories than you use</mattext>
              </material>
            </response_label>
            <response_label ident="5843">
              <material>
                <mattext texttype="text/plain">Focus only on protein intake, regardless of calories</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9005</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9005_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">3450</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="3450_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">8196</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="8196_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">5843</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="5843_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">9005</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="9005_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW143045400 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW143045400 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Weight maintenance occurs when energy intake (calories from food) balances energy expenditure (calories burned through metabolism and physical activity).&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW143045400 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="3450_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW69682396 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW69682396 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This leads to weight gain.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW69682396 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="8196_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW137382847 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW137382847 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This leads to weight loss.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW137382847 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="5843_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW146264982 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW146264982 BCX8" data-ccp-parastyle="Normal (Web)"&gt; While protein is important, overall caloric balance is crucial for weight management; focusing only on one macronutrient without considering total calories is insufficient.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW146264982 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g86414cd3189bae85b25df2c6a5ff7509" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>4626,6582,186,2633</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW644922 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW644922 BCX8" data-ccp-parastyle="Normal (Web)"&gt;What is the desired HDL (high-density lipoprotein or "good" cholesterol) level? &lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="4626">
