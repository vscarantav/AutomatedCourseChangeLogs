    </item>
    <item ident="g81b91e8d6c930a69e0588a3be2a229ef" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>6040,9171,6705,6010</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW68162290 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW68162290 BCX8" data-ccp-parastyle="Normal (Web)"&gt;At a cellular level, what primarily causes cancer?&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="6040">
              <material>
                <mattext texttype="text/plain">Flaws in the DNA replication sequence during cell reproduction</mattext>
              </material>
            </response_label>
            <response_label ident="9171">
              <material>
                <mattext texttype="text/plain">The body's immune system attacking healthy cells</mattext>
              </material>
            </response_label>
            <response_label ident="6705">
              <material>
                <mattext texttype="text/plain">A sudden bacterial infection in the body</mattext>
              </material>
            </response_label>
            <response_label ident="6010">
              <material>
                <mattext texttype="text/plain">A deficiency of essential vitamins</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">6040</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6040_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9171</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9171_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">6705</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6705_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">6010</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6010_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">6040</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="6040_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW211015001 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW211015001 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Cancer arises when genetic mutations (flaws in DNA) occur within cells, leading to uncontrolled cell growth and division, which the body's normal repair mechanisms fail to correct.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW211015001 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9171_fb">
