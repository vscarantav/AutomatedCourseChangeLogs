        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="4307">
              <material>
                <mattext texttype="text/plain">High blood pressure</mattext>
              </material>
            </response_label>
            <response_label ident="9504">
              <material>
                <mattext texttype="text/plain">Age</mattext>
              </material>
            </response_label>
            <response_label ident="8844">
              <material>
                <mattext texttype="text/plain">Race/Ethnicity</mattext>
              </material>
            </response_label>
            <response_label ident="9793">
              <material>
                <mattext texttype="text/plain">Family history of stroke</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
