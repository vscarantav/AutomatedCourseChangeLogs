      <itemfeedback ident="5762_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW249376827 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW249376827 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Processed foods often contain high levels of unhealthy fats, added sugars, and sodium, and are typically low in beneficial nutrients and fiber, making them generally unhealthy to consume in large quantities.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW249376827 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="8636_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW43076461 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW43076461 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Whole grains are recommended as part of a healthy diet due to their fiber content and other nutrients.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW43076461 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
