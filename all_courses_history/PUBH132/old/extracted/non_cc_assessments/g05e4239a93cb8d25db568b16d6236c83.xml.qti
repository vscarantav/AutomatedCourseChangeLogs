    <item ident="g1e74bd4b95229e0f259242fbc0b77eac" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>328,3898,4340,4760</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW261916587 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW261916587 BCX8" data-ccp-parastyle="Normal (Web)"&gt;What percentage of total daily calories should typically come from carbohydrates?&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="328">
              <material>
                <mattext texttype="text/plain">45–65%</mattext>
              </material>
            </response_label>
            <response_label ident="3898">
              <material>
                <mattext texttype="text/plain">10–35%</mattext>
              </material>
            </response_label>
            <response_label ident="4340">
              <material>
                <mattext texttype="text/plain">20–35%</mattext>
              </material>
            </response_label>
            <response_label ident="4760">
              <material>
                <mattext texttype="text/plain">Less than 10%</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">328</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="328_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">3898</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="3898_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">4340</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="4340_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">4760</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="4760_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">328</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="328_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW58327454 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW58327454 BCX8" data-ccp-parastyle="Normal (Web)"&gt;The recommended dietary guidelines suggest that carbohydrates should make up 45–65% of an individual's total daily caloric intake to provide adequate energy.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW58327454 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="3898_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW5240173 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW5240173 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This range is &lt;/span&gt;&lt;span class="NormalTextRun SCXW5240173 BCX8" data-ccp-parastyle="Normal (Web)"&gt;generally recommended&lt;/span&gt;&lt;span class="NormalTextRun SCXW5240173 BCX8" data-ccp-parastyle="Normal (Web)"&gt; for protein intake.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW5240173 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="4340_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW139414402 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW139414402 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This range is &lt;/span&gt;&lt;span class="NormalTextRun SCXW139414402 BCX8" data-ccp-parastyle="Normal (Web)"&gt;generally recommended&lt;/span&gt;&lt;span class="NormalTextRun SCXW139414402 BCX8" data-ccp-parastyle="Normal (Web)"&gt; for fat intake.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW139414402 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="4760_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW61806360 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW61806360 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This is far too low for a healthy carbohydrate intake and would &lt;/span&gt;&lt;span class="NormalTextRun SCXW61806360 BCX8" data-ccp-parastyle="Normal (Web)"&gt;likely lead&lt;/span&gt;&lt;span class="NormalTextRun SCXW61806360 BCX8" data-ccp-parastyle="Normal (Web)"&gt; to insufficient energy and nutrient deficiencies.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW61806360 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gaee01b94bec189a5cc79fa007fa62208" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>true_false_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
