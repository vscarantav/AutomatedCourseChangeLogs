          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6939_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">6676</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6676_fb"/>
