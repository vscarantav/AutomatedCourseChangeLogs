            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>3182,8598</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW64876354 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW64876354 BCX8" data-ccp-parastyle="Normal (Web)"&gt;True or False: Physical inactivity is a non-modifiable risk factor for heart disease. &lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="3182">
              <material>
                <mattext texttype="text/plain">True</mattext>
              </material>
            </response_label>
            <response_label ident="8598">
              <material>
                <mattext texttype="text/plain">False</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">3182</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="3182_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">8598</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="8598_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">8598</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="3182_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW65072593 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW65072593 BCX8" data-ccp-parastyle="Normal (Web)"&gt; This is incorrect. If it were a non-modifiable risk factor, it would mean it cannot be changed, which is contrary to the understanding of physical activity's role in health.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW65072593 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="8598_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW55352378 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW55352378 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Physical inactivity is a &lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXW55352378 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW55352378 BCX8" data-ccp-parastyle="Normal (Web)"&gt;modifiable&lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXW55352378 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW55352378 BCX8" data-ccp-parastyle="Normal (Web)"&gt; risk factor because individuals can choose to increase their level of physical activity through exercise and lifestyle changes, thereby influencing their risk of heart disease.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW55352378 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g353a5551199e1810187d96afd45801f7" title="Question">
