        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9504</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9504_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">8844</varequal>
