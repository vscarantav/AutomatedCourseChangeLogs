                <mattext texttype="text/plain">Sudden increase in appetite</mattext>
              </material>
            </response_label>
            <response_label ident="7491">
              <material>
                <mattext texttype="text/plain">Feeling overly energetic</mattext>
              </material>
            </response_label>
            <response_label ident="7452">
              <material>
                <mattext texttype="text/plain">Rapid hair growth</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
