    <item ident="g6c757cab49da7bd1a9a02224efedb533" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>7758,9252,4490,9755</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW2072817 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW2072817 BCX8" data-ccp-parastyle="Normal (Web)"&gt;What is one effective way to reduce your risk of developing chronic health conditions like heart disease, diabetes, and cancer?&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="7758">
              <material>
                <mattext texttype="text/plain">Practicing proper nutrition.</mattext>
              </material>
            </response_label>
            <response_label ident="9252">
              <material>
                <mattext texttype="text/plain">Increasing consumption of processed foods</mattext>
              </material>
            </response_label>
            <response_label ident="4490">
              <material>
                <mattext texttype="text/plain">Leading a sedentary lifestyle</mattext>
              </material>
            </response_label>
            <response_label ident="9755">
              <material>
                <mattext texttype="text/plain">Avoiding all types of dietary fat</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">7758</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="7758_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9252</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9252_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">4490</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="4490_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9755</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9755_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">7758</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="7758_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW36532818 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW36532818 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Adhering to a balanced and healthy diet, rich in whole foods and low in unhealthy processed items, is a cornerstone of preventing and managing many chronic diseases.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW36532818 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9252_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW235905679 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW235905679 BCX8" data-ccp-parastyle="Normal (Web)"&gt; This would increase, not decrease, the risk of these chronic conditions.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW235905679 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="4490_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW216995528 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW216995528 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Physical inactivity is a major risk factor for chronic diseases.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW216995528 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9755_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW34024136 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW34024136 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This is unhealthy, as essential fats are crucial for bodily functions, and healthy fats (unsaturated) can reduce disease risk.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW34024136 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
