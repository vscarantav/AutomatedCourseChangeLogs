        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">1913</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="1913_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">5172</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="5172_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">6470</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6470_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">3140</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="3140_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW74388324 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW74388324 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Most health organizations recommend that adults get between 6 and 9 hours of quality sleep per night for &lt;/span&gt;&lt;span class="NormalTextRun SCXW74388324 BCX8" data-ccp-parastyle="Normal (Web)"&gt;optimal&lt;/span&gt;&lt;span class="NormalTextRun SCXW74388324 BCX8" data-ccp-parastyle="Normal (Web)"&gt; physical and mental health.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW74388324 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="1913_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW132495798 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW132495798 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This is &lt;/span&gt;&lt;span class="NormalTextRun SCXW132495798 BCX8" data-ccp-parastyle="Normal (Web)"&gt;generally considered&lt;/span&gt;&lt;span class="NormalTextRun SCXW132495798 BCX8" data-ccp-parastyle="Normal (Web)"&gt; insufficient sleep for most adults and can lead to various health problems.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW132495798 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="5172_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW145300212 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW145300212 BCX8" data-ccp-parastyle="Normal (Web)"&gt;While some individuals may need more sleep, consistently sleeping this much without a medical reason could &lt;/span&gt;&lt;span class="NormalTextRun SCXW145300212 BCX8" data-ccp-parastyle="Normal (Web)"&gt;indicate&lt;/span&gt;&lt;span class="NormalTextRun SCXW145300212 BCX8" data-ccp-parastyle="Normal (Web)"&gt; an underlying health issue or is simply more than the average adult &lt;/span&gt;&lt;span class="NormalTextRun SCXW145300212 BCX8" data-ccp-parastyle="Normal (Web)"&gt;requires&lt;/span&gt;&lt;span class="NormalTextRun SCXW145300212 BCX8" data-ccp-parastyle="Normal (Web)"&gt;.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW145300212 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="6470_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW167895565 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW167895565 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This is severely insufficient sleep and highly detrimental to health.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW167895565 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g4b1bd5c0f89d00e21cf3835aa6062df0" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>1571,68,8572,7572</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW89387360 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW89387360 BCX8" data-ccp-parastyle="Normal (Web)"&gt;What happens to heart muscle when it experiences a lack of oxygenated blood during a heart attack?&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="1571">
              <material>
                <mattext texttype="text/plain">Portions of the heart muscle die</mattext>
              </material>
            </response_label>
            <response_label ident="68">
              <material>
                <mattext texttype="text/plain">The heart muscle becomes stronger</mattext>
              </material>
            </response_label>
            <response_label ident="8572">
              <material>
                <mattext texttype="text/plain">The heart muscle expands and heals itself</mattext>
              </material>
            </response_label>
            <response_label ident="7572">
              <material>
                <mattext texttype="text/plain">The heart muscle stops working temporarily</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">1571</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="1571_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">68</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="68_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">8572</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="8572_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">7572</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="7572_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">1571</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="1571_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW66129490 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW66129490 BCX8" data-ccp-parastyle="Normal (Web)"&gt;During a heart attack (myocardial infarction), the lack of oxygenated blood (ischemia) causes damage and eventual death of heart muscle tissue if blood flow is not restored quickly.&lt;/span&gt;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="68_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW126874150 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW126874150 BCX8" data-ccp-parastyle="Normal (Web)"&gt;A lack of oxygen does not make the heart muscle stronger; it weakens and damages it.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW126874150 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="8572_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW172726049 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW172726049 BCX8" data-ccp-parastyle="Normal (Web)"&gt;The heart muscle does not simply expand and heal itself in response to a lack of oxygen; the damaged tissue is often replaced by scar tissue, which does not contract.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW172726049 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="7572_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW104053551 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW104053551 BCX8" data-ccp-parastyle="Normal (Web)"&gt;While function is impaired, if blood flow is not restored, the damage is permanent due to tissue death, not just a temporary stop.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW104053551 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
