    <item ident="gd9efec51493bc42e3c6504f6c13880e9" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>9521,971,3581</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;A healthy diet consists of eating a variety of foods. We need carbohydrates, protein, and fats in our diet. Which of the following is a healthy source of fat?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="9521">
              <material>
                <mattext texttype="text/plain">Animal-based saturated fat</mattext>
              </material>
            </response_label>
            <response_label ident="971">
              <material>
                <mattext texttype="text/plain">Plant-based monounsaturated fat</mattext>
              </material>
            </response_label>
            <response_label ident="3581">
              <material>
                <mattext texttype="text/plain">Trans fat</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">971</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
    <item ident="g162e5a6fad0d8a16727ccea715511cc7" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>9751,6736,3621,1121</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW145659167 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW145659167 BCX8" data-ccp-parastyle="Normal (Web)"&gt;What are the three types of macronutrients?&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="9751">
              <material>
                <mattext texttype="text/plain">Carbohydrates, proteins, and fats</mattext>
              </material>
            </response_label>
            <response_label ident="6736">
              <material>
                <mattext texttype="text/plain">Vitamins, minerals, and water</mattext>
              </material>
            </response_label>
            <response_label ident="3621">
              <material>
                <mattext texttype="text/plain">Sugars, starches, and fiber</mattext>
              </material>
            </response_label>
            <response_label ident="1121">
              <material>
                <mattext texttype="text/plain">Amino acids, fatty acids, and glucose</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9751</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9751_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">6736</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6736_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">3621</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="3621_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">1121</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="1121_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">9751</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="9751_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW33259063 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW33259063 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Macronutrients are the nutrients the body needs in &lt;/span&gt;&lt;span class="NormalTextRun SCXW33259063 BCX8" data-ccp-parastyle="Normal (Web)"&gt;large amounts&lt;/span&gt;&lt;span class="NormalTextRun SCXW33259063 BCX8" data-ccp-parastyle="Normal (Web)"&gt; to provide energy. They include carbohydrates, proteins, and fats.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW33259063 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="6736_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW165703804 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW165703804 BCX8" data-ccp-parastyle="Normal (Web)"&gt;These are essential nutrients, but vitamins and minerals are micronutrients (needed in smaller amounts), and water, while vital, is not categorized as a macronutrient in terms of energy provision.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW165703804 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="3621_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW210033085 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW210033085 BCX8" data-ccp-parastyle="Normal (Web)"&gt;These are all types of carbohydrates, not the three distinct macronutrients.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW210033085 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="1121_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW116818553 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW116818553 BCX8" data-ccp-parastyle="Normal (Web)"&gt;These are the building blocks or breakdown products of proteins, fats, and carbohydrates, respectively, but not the macronutrients themselves.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW116818553 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g7c054e11197b9b1638943ef01d67a219" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>6383,6050,1294,9970</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW52690279 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW52690279 BCX8" data-ccp-parastyle="Normal (Web)"&gt;What is the body's main source of fuel?&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="6383">
              <material>
                <mattext texttype="text/plain">Carbohydrates</mattext>
              </material>
            </response_label>
            <response_label ident="6050">
              <material>
                <mattext texttype="text/plain">Fats</mattext>
              </material>
            </response_label>
            <response_label ident="1294">
              <material>
                <mattext texttype="text/plain">Proteins</mattext>
              </material>
            </response_label>
            <response_label ident="9970">
              <material>
                <mattext texttype="text/plain">Vitamins</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">6383</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6383_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">6050</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6050_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">1294</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="1294_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9970</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9970_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">6383</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="6383_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW38236271 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW38236271 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Carbohydrates are readily converted into glucose, which is the body's preferred and most efficient source of energy, fueling daily activities and bodily functions.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW38236271 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="6050_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW230388785 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW230388785 BCX8" data-ccp-parastyle="Normal (Web)"&gt;While fats are an important source of concentrated energy, they are typically used for fuel after carbohydrate stores are depleted or for long-duration, low-intensity activities. They are not the &lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXW230388785 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW230388785 BCX8" data-ccp-parastyle="Normal (Web)"&gt;main&lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXW230388785 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW230388785 BCX8" data-ccp-parastyle="Normal (Web)"&gt; immediate source.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW230388785 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="1294_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW190130948 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW190130948 BCX8" data-ccp-parastyle="Normal (Web)"&gt; Proteins are primarily used for building and repairing tissues, making enzymes and hormones, and other bodily functions. They are used for energy only when carbohydrate and fat stores are insufficient.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW190130948 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9970_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW73979184 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW73979184 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Vitamins are organic compounds that help regulate body processes and are crucial for health, but they do not provide energy (calories).&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW73979184 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g7b74ad2a64d5ebb7448a1d5b9f0ebd4d" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>4990,8237,9034,6518</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW64495262 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW64495262 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Which type of fat should you primarily avoid for heart health?&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="4990">
              <material>
                <mattext texttype="text/plain">Trans fat</mattext>
              </material>
            </response_label>
            <response_label ident="8237">
              <material>
                <mattext texttype="text/plain">Unsaturated fat</mattext>
              </material>
            </response_label>
            <response_label ident="9034">
              <material>
                <mattext texttype="text/plain">Monounsaturated fat</mattext>
              </material>
            </response_label>
            <response_label ident="6518">
              <material>
                <mattext texttype="text/plain">Polyunsaturated fat</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">4990</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="4990_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">8237</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="8237_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9034</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9034_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">6518</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6518_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">4990</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="4990_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW229111293 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW229111293 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Trans fats are artificially created fats that raise LDL ("bad") cholesterol and lower HDL ("good") cholesterol, significantly increasing the risk of heart disease.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW229111293 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="8237_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW147886617 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW147886617 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Unsaturated fats (including monounsaturated and polyunsaturated fats) are &lt;/span&gt;&lt;span class="NormalTextRun SCXW147886617 BCX8" data-ccp-parastyle="Normal (Web)"&gt;generally considered&lt;/span&gt;&lt;span class="NormalTextRun SCXW147886617 BCX8" data-ccp-parastyle="Normal (Web)"&gt; healthy fats that can improve cholesterol levels and reduce the risk of heart disease.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW147886617 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9034_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW71583313 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW71583313 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This is a type of healthy unsaturated fat found in foods like olive oil and avocados, known for its heart-protective benefits.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW71583313 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="6518_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW186810172 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW186810172 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This is another type of healthy unsaturated fat, including omega-3 and omega-6 fatty acids, found in foods like fatty fish and walnuts, which are beneficial for health.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW186810172 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g61fc65227a8820ee1cc7bd7b2e64e71a" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>4204,958,3885,8034</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW247311632 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW247311632 BCX8" data-ccp-parastyle="Normal (Web)"&gt; What is atherosclerosis? &lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="4204">
              <material>
                <mattext texttype="text/plain">The buildup of plaque on the inside of blood vessels</mattext>
              </material>
            </response_label>
