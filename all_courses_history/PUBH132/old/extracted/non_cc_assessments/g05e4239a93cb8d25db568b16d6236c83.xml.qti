      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW183700227 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW183700227 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Which of the following is a &lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXW183700227 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW183700227 BCX8" data-ccp-parastyle="Normal (Web)"&gt;modifiable&lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXW183700227 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW183700227 BCX8" data-ccp-parastyle="Normal (Web)"&gt; risk factor for heart disease? &lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="8363">
