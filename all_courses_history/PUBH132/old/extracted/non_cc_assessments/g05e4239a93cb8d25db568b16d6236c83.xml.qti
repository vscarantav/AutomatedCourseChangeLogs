        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">964</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="964_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">161</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="161_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">5883</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="5883_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">1593</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="1593_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW156456055 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW156456055 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Carbohydrates are the primary fuel source for physical activity. Therefore, individuals who are more physically active, especially those engaging in moderate to high-intensity exercise, require a greater intake of carbohydrates to fuel their muscles and replenish glycogen stores.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW156456055 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="964_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW167501654 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW167501654 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This is incorrect; intense physical activity demands more energy from carbohydrates.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW167501654 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="161_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW62421418 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW62421418 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This is incorrect; energy expenditure directly impacts macronutrient needs, especially for carbohydrates.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW62421418 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="5883_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW193900625 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW193900625 BCX8" data-ccp-parastyle="Normal (Web)"&gt;While macronutrients interact, carbohydrate needs are primarily driven by energy expenditure (activity level), not solely by protein intake.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW193900625 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
