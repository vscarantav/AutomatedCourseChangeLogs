            <mattext texttype="text/html">&lt;span class="TextRun SCXW228420361 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW228420361 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This is a modifiable risk factor that can be managed through lifestyle changes and medication.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW228420361 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
