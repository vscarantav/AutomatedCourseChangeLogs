        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW17427284 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW17427284 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Social interaction is part of social wellness, not the direct hallmark of intellectual wellness.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW17427284 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
