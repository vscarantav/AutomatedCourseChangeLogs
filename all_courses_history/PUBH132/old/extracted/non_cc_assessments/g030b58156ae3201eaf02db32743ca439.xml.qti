        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="1522">
              <material>
                <mattext texttype="text/plain">They find great joy in gaining new knowledge.</mattext>
              </material>
            </response_label>
            <response_label ident="4384">
              <material>
                <mattext texttype="text/plain">They resist new ideas.</mattext>
              </material>
            </response_label>
            <response_label ident="8024">
              <material>
                <mattext texttype="text/plain">They prefer routine over creativity.</mattext>
              </material>
            </response_label>
            <response_label ident="9003">
              <material>
                <mattext texttype="text/plain">They avoid learning new things.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
