          <render_choice>
            <response_label ident="3423">
              <material>
                <mattext texttype="text/plain">You will have peace of mind in knowing that you have prepared yourself for the eventualities that you may encounter in life.</mattext>
              </material>
            </response_label>
            <response_label ident="3086">
              <material>
                <mattext texttype="text/plain">Peace of mind comes from avoiding challenges.</mattext>
              </material>
            </response_label>
            <response_label ident="6567">
              <material>
                <mattext texttype="text/plain">Peace of mind is unrelated to learning.</mattext>
              </material>
            </response_label>
            <response_label ident="5997">
              <material>
                <mattext texttype="text/plain">Peace of mind is only achieved through wealth.</mattext>
