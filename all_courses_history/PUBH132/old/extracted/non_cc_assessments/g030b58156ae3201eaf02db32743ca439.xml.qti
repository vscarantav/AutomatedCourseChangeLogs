                <mattext texttype="text/plain">It is lost upon death.</mattext>
              </material>
            </response_label>
            <response_label ident="6867">
              <material>
                <mattext texttype="text/plain">It is forgotten in the world to come.</mattext>
              </material>
            </response_label>
