      <itemfeedback ident="9137_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW166065180 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW166065180 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Holding your breath while stretching is incorrect; you should breathe normally or deeply to relax into the stretch.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW166065180 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="6001_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW248397788 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW248397788 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Stretching should involve feeling tension, not extreme or sharp pain, as pain is a sign of potential injury.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW248397788 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="2218_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW60569438 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW60569438 BCX8" data-ccp-parastyle="Normal (Web)"&gt; It is important to warm up muscles with light aerobic activity before stretching to increase their elasticity and reduce the risk of injury.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW60569438 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
