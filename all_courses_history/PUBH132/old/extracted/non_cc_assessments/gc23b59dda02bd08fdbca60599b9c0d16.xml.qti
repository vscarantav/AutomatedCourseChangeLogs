            <mattext texttype="text/html">&lt;span class="TextRun SCXW32962760 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW32962760 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Doing a single maximal lift is a test and builder of muscular &lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXW32962760 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW32962760 BCX8" data-ccp-parastyle="Normal (Web)"&gt;strength&lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXW32962760 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW32962760 BCX8" data-ccp-parastyle="Normal (Web)"&gt;, not muscular endurance.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW32962760 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="654_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW8827294 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW8827294 BCX8" data-ccp-parastyle="Normal (Web)"&gt; Holding a stretch for 30 seconds is a technique for improving flexibility, not muscular endurance.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="6059_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW48961863 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW48961863 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Sprinting for 10 seconds is an anaerobic activity that builds power and speed, rather than the sustained, repetitive muscle contractions characteristic of muscular endurance.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW48961863 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
