      <itemfeedback ident="1238_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW203151032 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW203151032 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Atrophy is the &lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXW203151032 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW203151032 BCX8" data-ccp-parastyle="Normal (Web)"&gt;decrease&lt;/span&gt;&lt;/span&gt;&lt;span class="TextRun SCXW203151032 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW203151032 BCX8" data-ccp-parastyle="Normal (Web)"&gt; in muscle size, or muscle wasting, which is the opposite of hypertrophy.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW203151032 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
