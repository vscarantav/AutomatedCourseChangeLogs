            <response_label ident="130">
              <material>
                <mattext texttype="text/plain">Do not bounce</mattext>
              </material>
            </response_label>
            <response_label ident="9137">
              <material>
                <mattext texttype="text/plain">Hold your breath</mattext>
              </material>
            </response_label>
            <response_label ident="6001">
              <material>
                <mattext texttype="text/plain">Feel extreme pain</mattext>
              </material>
            </response_label>
            <response_label ident="2218">
              <material>
                <mattext texttype="text/plain">Stretch cold muscles</mattext>
              </material>
            </response_label>
          </render_choice>
