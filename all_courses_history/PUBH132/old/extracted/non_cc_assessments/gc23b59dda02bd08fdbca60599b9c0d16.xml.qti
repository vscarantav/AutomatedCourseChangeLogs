        <response_lid ident="response_6906">
          <material>
            <mattext texttype="text/plain">Cardiorespiratory Endurance</mattext>
          </material>
          <render_choice>
            <response_label ident="9529">
              <material>
                <mattext>The ability of the heart, lungs, and circulatory system to deliver oxygen and nutrients to your working muscles during sustained physical activity.</mattext>
              </material>
            </response_label>
            <response_label ident="4709">
              <material>
                <mattext>The ability of your muscles to exert force.</mattext>
              </material>
            </response_label>
            <response_label ident="6990">
              <material>
                <mattext>The ability to repeatedly contract a muscle or muscle group for several minutes.</mattext>
              </material>
            </response_label>
            <response_label ident="9488">
              <material>
                <mattext>The ability to move your joints through an optimal range of motion.</mattext>
              </material>
            </response_label>
            <response_label ident="8880">
              <material>
                <mattext>Having a good relationship with your surroundings, with a core principle of respect for nature and our earth.</mattext>
              </material>
            </response_label>
            <response_label ident="9735">
              <material>
                <mattext>The dimension characterized by self-esteem, optimism, self-control, and the ability to adjust to changing environments.</mattext>
              </material>
            </response_label>
            <response_label ident="2547">
              <material>
                <mattext>The dimension that is the easiest to understand and most frequently referred to when considering health, including components like infirmity and fitness.</mattext>
              </material>
            </response_label>
            <response_label ident="8015">
              <material>
                <mattext>The dimension characterized by the ability to critically think and reason, creativity, openness to new ideas, and curiosity.</mattext>
              </material>
            </response_label>
            <response_label ident="5201">
              <material>
                <mattext>The dimension involving all interactions between ourselves and others, emphasizing sensitivity, love, respect, honesty, fairness, and kindness towards others.</mattext>
              </material>
            </response_label>
            <response_label ident="243">
              <material>
                <mattext>The dimension involving faith, morals, belief systems, and values that help a person make sound decisions.</mattext>
              </material>
            </response_label>
          </render_choice>
