      <itemfeedback ident="4439_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW194599187 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW194599187 BCX8" data-ccp-charstyle="citation-1905" data-ccp-charstyle-defn="{&amp;quot;ObjectId&amp;quot;:&amp;quot;5a603d13-c982-5766-97da-9e5deb291a1e|1&amp;quot;,&amp;quot;ClassId&amp;quot;:1073872969,&amp;quot;Properties&amp;quot;:[201342446,&amp;quot;1&amp;quot;,201342447,&amp;quot;5&amp;quot;,201342448,&amp;quot;1&amp;quot;,201342449,&amp;quot;1&amp;quot;,469777841,&amp;quot;Aptos&amp;quot;,469777842,&amp;quot;&amp;quot;,469777843,&amp;quot;Aptos&amp;quot;,469777844,&amp;quot;Aptos&amp;quot;,201341986,&amp;quot;1&amp;quot;,469769226,&amp;quot;Aptos&amp;quot;,268442635,&amp;quot;24&amp;quot;,469775450,&amp;quot;citation-1905&amp;quot;,201340122,&amp;quot;1&amp;quot;,134233614,&amp;quot;true&amp;quot;,469778129,&amp;quot;citation-1905&amp;quot;,335572020,&amp;quot;1&amp;quot;,469778324,&amp;quot;Default Paragraph Font&amp;quot;]}"&gt;Fitness primarily refers to physical capabilities and is only one &lt;/span&gt;&lt;span class="NormalTextRun SCXW194599187 BCX8" data-ccp-charstyle="citation-1905"&gt;component&lt;/span&gt;&lt;span class="NormalTextRun SCXW194599187 BCX8" data-ccp-charstyle="citation-1905"&gt; of physical wellness, not the overarching personal state of well-being&lt;/span&gt;&lt;span class="NormalTextRun SCXW194599187 BCX8" data-ccp-parastyle="Normal (Web)"&gt;.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW194599187 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
