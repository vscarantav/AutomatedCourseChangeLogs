      <itemfeedback ident="6906_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW261477928 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW261477928 BCX8"&gt;Cardiorespiratory endurance is specifically defined as the ability of the heart, lungs, and circulatory system to deliver oxygen and nutrients to working muscles during sustained physical activity.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW261477928 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="1513_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW113215558 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW113215558 BCX8"&gt;Muscular strength is &lt;/span&gt;&lt;span class="NormalTextRun SCXW113215558 BCX8"&gt;directly defined&lt;/span&gt;&lt;span class="NormalTextRun SCXW113215558 BCX8"&gt; as the ability of your muscles to exert force.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW113215558 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="2838_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW132278855 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW132278855 BCX8"&gt;Muscular endurance is defined as the ability to repeatedly contract a muscle or muscle group for several minutes.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW132278855 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="3910_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW251182985 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW251182985 BCX8"&gt;Flexibility is clearly defined as the ability to move your joints through &lt;/span&gt;&lt;span class="NormalTextRun SCXW251182985 BCX8"&gt;an optimal&lt;/span&gt;&lt;span class="NormalTextRun SCXW251182985 BCX8"&gt; range of motion.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW251182985 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="1072_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW197527388 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW197527388 BCX8"&gt;Environmental wellness is described as having a good relationship with your surroundings, with its core principle being respect for nature and our earth.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW197527388 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="5423_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW208635577 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW208635577 BCX8"&gt;Emotional wellness is characterized by hallmarks such as self-esteem, optimism, self-control, and the ability to adjust to changing environments.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW208635577 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="6888_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW128274746 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW128274746 BCX8"&gt; Physical wellness is &lt;/span&gt;&lt;span class="NormalTextRun SCXW128274746 BCX8"&gt;stated&lt;/span&gt;&lt;span class="NormalTextRun SCXW128274746 BCX8"&gt; to be the easiest to understand and most &lt;/span&gt;&lt;span class="NormalTextRun SCXW128274746 BCX8"&gt;frequently&lt;/span&gt;&lt;span class="NormalTextRun SCXW128274746 BCX8"&gt; referred to when considering health, encompassing components like infirmity, infection, fitness, and performance.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW128274746 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9816_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW60644539 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW60644539 BCX8"&gt;Intellectual wellness is characterized by the ability to critically think and reason, creativity, openness to &lt;/span&gt;&lt;span class="NormalTextRun SCXW60644539 BCX8"&gt;new ideas&lt;/span&gt;&lt;span class="NormalTextRun SCXW60644539 BCX8"&gt;, and curiosity.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW60644539 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="5194_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW176668789 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW176668789 BCX8"&gt;Social wellness encompasses all interactions between individuals and emphasizes traits like being sensitive and loving to others, treating them with respect, being honest, fair, and trustworthy, and being kind.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW176668789 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
