        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW206328530 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW206328530 BCX8" data-ccp-charstyle="citation-1907" data-ccp-charstyle-defn="{&amp;quot;ObjectId&amp;quot;:&amp;quot;d98df8df-807b-521d-90e4-25bf665842df|1&amp;quot;,&amp;quot;ClassId&amp;quot;:1073872969,&amp;quot;Properties&amp;quot;:[201342446,&amp;quot;1&amp;quot;,201342447,&amp;quot;5&amp;quot;,201342448,&amp;quot;1&amp;quot;,201342449,&amp;quot;1&amp;quot;,469777841,&amp;quot;Aptos&amp;quot;,469777842,&amp;quot;&amp;quot;,469777843,&amp;quot;Aptos&amp;quot;,469777844,&amp;quot;Aptos&amp;quot;,201341986,&amp;quot;1&amp;quot;,469769226,&amp;quot;Aptos&amp;quot;,268442635,&amp;quot;24&amp;quot;,469775450,&amp;quot;citation-1907&amp;quot;,201340122,&amp;quot;1&amp;quot;,134233614,&amp;quot;true&amp;quot;,469778129,&amp;quot;citation-1907&amp;quot;,335572020,&amp;quot;1&amp;quot;,469778324,&amp;quot;Default Paragraph Font&amp;quot;]}"&gt;Health is often &lt;/span&gt;&lt;span class="NormalTextRun SCXW206328530 BCX8" data-ccp-charstyle="citation-1907"&gt;considered simply&lt;/span&gt;&lt;span class="NormalTextRun SCXW206328530 BCX8" data-ccp-charstyle="citation-1907"&gt; the absence of illness or &lt;/span&gt;&lt;span class="NormalTextRun ContextualSpellingAndGrammarErrorV2Themed SCXW206328530 BCX8" data-ccp-charstyle="citation-1907"&gt;disease &lt;/span&gt;&lt;span class="NormalTextRun ContextualSpellingAndGrammarErrorV2Themed SCXW206328530 BCX8" data-ccp-charstyle="citation-1906" data-ccp-charstyle-defn="{&amp;quot;ObjectId&amp;quot;:&amp;quot;80ce70a5-7f61-546d-92b3-498a399aa0d8|1&amp;quot;,&amp;quot;ClassId&amp;quot;:1073872969,&amp;quot;Properties&amp;quot;:[201342446,&amp;quot;1&amp;quot;,201342447,&amp;quot;5&amp;quot;,201342448,&amp;quot;1&amp;quot;,201342449,&amp;quot;1&amp;quot;,469777841,&amp;quot;Aptos&amp;quot;,469777842,&amp;quot;&amp;quot;,469777843,&amp;quot;Aptos&amp;quot;,469777844,&amp;quot;Aptos&amp;quot;,201341986,&amp;quot;1&amp;quot;,469769226,&amp;quot;Aptos&amp;quot;,268442635,&amp;quot;24&amp;quot;,469775450,&amp;quot;citation-1906&amp;quot;,201340122,&amp;quot;1&amp;quot;,134233614,&amp;quot;true&amp;quot;,469778129,&amp;quot;citation-1906&amp;quot;,335572020,&amp;quot;1&amp;quot;,469778324,&amp;quot;Default Paragraph Font&amp;quot;]}"&gt;,&lt;/span&gt;&lt;span class="NormalTextRun SCXW206328530 BCX8" data-ccp-charstyle="citation-1906"&gt; which is a narrower definition compared to the comprehensive scope of wellness as defined in the course material&lt;/span&gt;&lt;span class="NormalTextRun SCXW206328530 BCX8" data-ccp-parastyle="Normal (Web)"&gt;.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW206328530 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
