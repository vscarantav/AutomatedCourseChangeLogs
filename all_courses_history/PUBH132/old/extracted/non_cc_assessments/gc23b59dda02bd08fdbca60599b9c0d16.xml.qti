          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW145922815 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW145922815 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Scientific studies have shown that individuals who love others have improved immune function and can tolerate pain better.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW145922815 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="8619">
              <material>
                <mattext texttype="text/plain">True</mattext>
              </material>
            </response_label>
            <response_label ident="7340">
              <material>
                <mattext texttype="text/plain">False</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">7340</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="7340_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">8619</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="7340_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW165541640 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW165541640 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This statement is true. &lt;/span&gt;&lt;span class="NormalTextRun SCXW165541640 BCX8" data-ccp-parastyle="Normal (Web)"&gt;L&lt;/span&gt;&lt;span class="NormalTextRun SCXW165541640 BCX8" data-ccp-parastyle="Normal (Web)"&gt;oving others &lt;/span&gt;&lt;span class="NormalTextRun SCXW165541640 BCX8" data-ccp-parastyle="Normal (Web)"&gt;is&lt;/span&gt;&lt;span class="NormalTextRun SCXW165541640 BCX8" data-ccp-parastyle="Normal (Web)"&gt; associated with tangible health benefits, including enhanced immune function and increased pain tolerance.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW165541640 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
