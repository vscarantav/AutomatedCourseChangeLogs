          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW248168197 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW248168197 BCX8" data-ccp-parastyle="Normal (Web)"&gt;What is an important guideline to follow when stretching to avoid injury?&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW248168197 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;</mattext>
