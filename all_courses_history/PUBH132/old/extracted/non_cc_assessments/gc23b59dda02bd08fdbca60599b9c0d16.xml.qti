      </itemfeedback>
      <itemfeedback ident="6343_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW195069202 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW195069202 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Flexibility refers to the range of motion around a joint, not the size of the muscle.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW195069202 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="4334_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW132397376 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW132397376 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Endurance refers to the ability of a muscle to sustain repeated contractions, not an increase in its size.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW132397376 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
