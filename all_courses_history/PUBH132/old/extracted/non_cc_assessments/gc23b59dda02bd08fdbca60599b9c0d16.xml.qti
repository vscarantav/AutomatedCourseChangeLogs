      <itemfeedback ident="7056_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW266819280 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW266819280 BCX8" data-ccp-charstyle="citation-1904" data-ccp-charstyle-defn="{&amp;quot;ObjectId&amp;quot;:&amp;quot;f58d7f4a-0c56-536d-ac60-fa3f7b82f602|1&amp;quot;,&amp;quot;ClassId&amp;quot;:1073872969,&amp;quot;Properties&amp;quot;:[201342446,&amp;quot;1&amp;quot;,201342447,&amp;quot;5&amp;quot;,201342448,&amp;quot;1&amp;quot;,201342449,&amp;quot;1&amp;quot;,469777841,&amp;quot;Aptos&amp;quot;,469777842,&amp;quot;&amp;quot;,469777843,&amp;quot;Aptos&amp;quot;,469777844,&amp;quot;Aptos&amp;quot;,201341986,&amp;quot;1&amp;quot;,469769226,&amp;quot;Aptos&amp;quot;,268442635,&amp;quot;24&amp;quot;,469775450,&amp;quot;citation-1904&amp;quot;,201340122,&amp;quot;1&amp;quot;,134233614,&amp;quot;true&amp;quot;,469778129,&amp;quot;citation-1904&amp;quot;,335572020,&amp;quot;1&amp;quot;,469778324,&amp;quot;Default Paragraph Font&amp;quot;]}"&gt;Morality pertains to principles of right and wrong and is a &lt;/span&gt;&lt;span class="NormalTextRun SCXW266819280 BCX8" data-ccp-charstyle="citation-1904"&gt;component&lt;/span&gt;&lt;span class="NormalTextRun SCXW266819280 BCX8" data-ccp-charstyle="citation-1904"&gt; of spiritual &lt;/span&gt;&lt;span class="NormalTextRun ContextualSpellingAndGrammarErrorV2Themed SCXW266819280 BCX8" data-ccp-charstyle="citation-1904"&gt;wellness &lt;/span&gt;&lt;span class="NormalTextRun ContextualSpellingAndGrammarErrorV2Themed SCXW266819280 BCX8" data-ccp-charstyle="citation-1903" data-ccp-charstyle-defn="{&amp;quot;ObjectId&amp;quot;:&amp;quot;40c953f9-ec52-5ad8-9156-4c8705780ba2|1&amp;quot;,&amp;quot;ClassId&amp;quot;:1073872969,&amp;quot;Properties&amp;quot;:[201342446,&amp;quot;1&amp;quot;,201342447,&amp;quot;5&amp;quot;,201342448,&amp;quot;1&amp;quot;,201342449,&amp;quot;1&amp;quot;,469777841,&amp;quot;Aptos&amp;quot;,469777842,&amp;quot;&amp;quot;,469777843,&amp;quot;Aptos&amp;quot;,469777844,&amp;quot;Aptos&amp;quot;,201341986,&amp;quot;1&amp;quot;,469769226,&amp;quot;Aptos&amp;quot;,268442635,&amp;quot;24&amp;quot;,469775450,&amp;quot;citation-1903&amp;quot;,201340122,&amp;quot;1&amp;quot;,134233614,&amp;quot;true&amp;quot;,469778129,&amp;quot;citation-1903&amp;quot;,335572020,&amp;quot;1&amp;quot;,469778324,&amp;quot;Default Paragraph Font&amp;quot;]}"&gt;,&lt;/span&gt;&lt;span class="NormalTextRun SCXW266819280 BCX8" data-ccp-charstyle="citation-1903"&gt; but it does not encompass all seven dimensions of wellness&lt;/span&gt;&lt;span class="NormalTextRun SCXW266819280 BCX8" data-ccp-parastyle="Normal (Web)"&gt;.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW266819280 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
