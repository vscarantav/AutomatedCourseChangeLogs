    <item ident="g023fadf4ee0da6b0a3dd12f5d61d866d" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>2121,7627,9454,4083</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW160373856 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW160373856 BCX8" data-ccp-parastyle="Normal (Web)"&gt;According to the World Health Organization (WHO), how many minutes of moderate-intensity aerobic physical activity should adults aim for per week?&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW160373856 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="2121">
              <material>
                <mattext texttype="text/plain">150-300 minutes</mattext>
              </material>
            </response_label>
            <response_label ident="7627">
              <material>
                <mattext texttype="text/plain">30-60 minutes</mattext>
              </material>
            </response_label>
            <response_label ident="9454">
              <material>
                <mattext texttype="text/plain">600+ minutes</mattext>
              </material>
            </response_label>
            <response_label ident="4083">
              <material>
                <mattext texttype="text/plain">No specific recommendation</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">7627</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="7627_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9454</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9454_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">4083</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="4083_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">2121</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="7627_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW122727270 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW122727270 BCX8" data-ccp-parastyle="Normal (Web)"&gt;30-60 minutes is often a daily recommendation for moderate activity, but the WHO's weekly recommendation for adults is 150-&lt;/span&gt;&lt;span class="NormalTextRun AdvancedProofingIssueV2Themed SCXW122727270 BCX8" data-ccp-parastyle="Normal (Web)"&gt;300 minutes&lt;/span&gt;&lt;span class="NormalTextRun SCXW122727270 BCX8" data-ccp-parastyle="Normal (Web)"&gt;.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW122727270 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9454_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW244179633 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW244179633 BCX8" data-ccp-parastyle="Normal (Web)"&gt;While more physical activity can be beneficial, 600+ minutes is significantly above the specific moderate-intensity weekly recommendation provided by the WHO.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW244179633 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="4083_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW129736823 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW129736823 BCX8" data-ccp-parastyle="Normal (Web)"&gt;The WHO provides clear and specific recommendations for both moderate and vigorous-intensity physical activity for adults, so this statement is incorrect.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW129736823 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g919d4f245d98c5d89958d70ea5b7b342" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>7649,4170,5901,3789</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW144942487 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW144942487 BCX8" data-ccp-parastyle="Normal (Web)"&gt;How many times per week does the World Health Organization (WHO) recommend that adults engage in muscle-strengthening activities?&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW144942487 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="7649">
              <material>
                <mattext texttype="text/plain">At least twice per week</mattext>
              </material>
            </response_label>
            <response_label ident="4170">
              <material>
                <mattext texttype="text/plain">Once a week</mattext>
              </material>
            </response_label>
            <response_label ident="5901">
              <material>
                <mattext texttype="text/plain">Every day</mattext>
              </material>
            </response_label>
            <response_label ident="3789">
              <material>
                <mattext texttype="text/plain">Not recommended for adults</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
