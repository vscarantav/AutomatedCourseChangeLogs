          <render_choice>
            <response_label ident="3086">
              <material>
                <mattext texttype="text/plain">Hypertrophy</mattext>
              </material>
            </response_label>
            <response_label ident="1238">
              <material>
                <mattext texttype="text/plain">Atrophy</mattext>
              </material>
            </response_label>
            <response_label ident="6343">
              <material>
                <mattext texttype="text/plain">Flexibility</mattext>
              </material>
            </response_label>
            <response_label ident="4334">
              <material>
                <mattext texttype="text/plain">Endurance</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
