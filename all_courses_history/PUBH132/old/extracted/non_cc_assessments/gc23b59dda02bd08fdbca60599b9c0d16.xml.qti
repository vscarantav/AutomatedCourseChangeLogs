0,&amp;quot;citation-1873&amp;quot;,201340122,&amp;quot;1&amp;quot;,134233614,&amp;quot;true&amp;quot;,469778129,&amp;quot;citation-1873&amp;quot;,335572020,&amp;quot;1&amp;quot;,469778324,&amp;quot;Default Paragraph Font&amp;quot;]}"&gt;,&lt;/span&gt; &lt;span class="NormalTextRun SCXW66199911 BCX8" data-ccp-charstyle="citation-1873"&gt;whereas&lt;/span&gt;&lt;span class="NormalTextRun SCXW66199911 BCX8" data-ccp-charstyle="citation-1873"&gt; intellectual wellness specifically refers to cognitive abilities like critical thinking and creativity&lt;/span&gt;&lt;span class="NormalTextRun SCXW66199911 BCX8" data-ccp-parastyle="Normal (Web)"&gt;.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW66199911 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
