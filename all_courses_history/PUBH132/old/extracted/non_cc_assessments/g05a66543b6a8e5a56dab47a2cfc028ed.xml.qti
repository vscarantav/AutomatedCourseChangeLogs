          <conditionvar>
            <varequal respident="response1">6170</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="3687_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW144771266 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW144771266 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Depression typically causes a significant decrease in energy, leading to fatigue and lethargy, rather than increased energy levels.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW144771266 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="2044_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW125873142 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW125873142 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Extreme euphoria, or an abnormally elevated mood, is a symptom associated with mania in bipolar disorder, not typical depression.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW125873142 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="2328_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW14031963 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW14031963 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Depression often impairs cognitive functions, leading to difficulty concentrating, impaired memory, and a general lack of focus, rather than heightened focus.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW14031963 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g2dd11a2dbf91d504d960e37fe4c61912" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>373,6730,801,4924</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW263179833 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW263179833 BCX8" data-ccp-parastyle="Normal (Web)"&gt;According to mental health guidelines, what is the effect of directly asking someone if they are thinking about suicide?&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW263179833 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="373">
              <material>
                <mattext texttype="text/plain">It does not put the idea in their head, but instead can open a path for discussion and help.</mattext>
              </material>
            </response_label>
            <response_label ident="6730">
              <material>
                <mattext texttype="text/plain">It will immediately cause them to attempt suicide</mattext>
              </material>
            </response_label>
            <response_label ident="801">
              <material>
                <mattext texttype="text/plain">It makes them angry and resentful</mattext>
              </material>
            </response_label>
            <response_label ident="4924">
              <material>
                <mattext texttype="text/plain">It is considered disrespectful and invasive</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">6730</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6730_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">801</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="801_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">4924</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="4924_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">373</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="6730_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW257329722 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW257329722 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This is a dangerous misconception. Directly asking about suicidal thoughts is a critical step in suicide prevention and can provide relief and an opportunity for the individual to seek help.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW257329722 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="801_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW156843483 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW156843483 BCX8" data-ccp-parastyle="Normal (Web)"&gt;While some individuals might react with &lt;/span&gt;&lt;span class="NormalTextRun SCXW156843483 BCX8" data-ccp-parastyle="Normal (Web)"&gt;initial&lt;/span&gt;&lt;span class="NormalTextRun SCXW156843483 BCX8" data-ccp-parastyle="Normal (Web)"&gt; discomfort, for many who are struggling, being directly asked about suicide can bring a sense of relief that someone cares and is willing to talk about a difficult topic.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW156843483 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="4924_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW14887827 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW14887827 BCX8" data-ccp-parastyle="Normal (Web)"&gt;While it is a very personal question, in the context of mental health crisis or concern for someone's well-being, directly asking about suicide is considered a compassionate and necessary intervention, not disrespectful.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW14887827 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g3d8c8284c5651e32430a1a8641e77358" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>2448,2891,9864,4789</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW233070767 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW233070767 BCX8" data-ccp-parastyle="Normal (Web)"&gt;What is defined as a persistent dependence on a harmful behavior or substance?&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="2448">
              <material>
                <mattext texttype="text/plain">Addiction</mattext>
              </material>
            </response_label>
            <response_label ident="2891">
              <material>
                <mattext texttype="text/plain">Habit</mattext>
              </material>
            </response_label>
            <response_label ident="9864">
              <material>
                <mattext texttype="text/plain">Obsession</mattext>
              </material>
            </response_label>
            <response_label ident="4789">
              <material>
                <mattext texttype="text/plain">Craving</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">2891</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="2891_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9864</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9864_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">4789</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="4789_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">2448</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="2891_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW181044803 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW181044803 BCX8" data-ccp-parastyle="Normal (Web)"&gt;A habit is a routine behavior often performed unconsciously, but it does not necessarily involve the compulsive, harmful &lt;/span&gt;&lt;span class="NormalTextRun SCXW181044803 BCX8" data-ccp-parastyle="Normal (Web)"&gt;dependence&lt;/span&gt;&lt;span class="NormalTextRun SCXW181044803 BCX8" data-ccp-parastyle="Normal (Web)"&gt; and loss of control characteristic of an addiction.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW181044803 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9864_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW150122343 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW150122343 BCX8" data-ccp-parastyle="Normal (Web)"&gt;An obsession is an unwanted, intrusive thought or image, often associated with obsessive-compulsive disorder, which is distinct from a persistent dependence on a behavior or substance.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW150122343 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="4789_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW28159680 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW28159680 BCX8" data-ccp-parastyle="Normal (Web)"&gt;A craving is an intense desire for a substance or behavior, which is a symptom or &lt;/span&gt;&lt;span class="NormalTextRun SCXW28159680 BCX8" data-ccp-parastyle="Normal (Web)"&gt;component&lt;/span&gt;&lt;span class="NormalTextRun SCXW28159680 BCX8" data-ccp-parastyle="Normal (Web)"&gt; of addiction, but it is not the definition of addiction itself.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW28159680 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g45f0732443994a365f3d26b86f6039f5" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>7229,6558,9955,3591</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW148590585 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW148590585 BCX8" data-ccp-parastyle="Normal (Web)"&gt;According to Elder M. Russell Ballard, what does "any kind of addiction" involve?&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW148590585 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="7229">
              <material>
                <mattext texttype="text/plain">Surrendering to something and relinquishing agency.</mattext>
              </material>
            </response_label>
            <response_label ident="6558">
              <material>
                <mattext texttype="text/plain">Gaining valuable insights</mattext>
              </material>
            </response_label>
            <response_label ident="9955">
              <material>
                <mattext texttype="text/plain">Enhancing personal freedom</mattext>
              </material>
            </response_label>
            <response_label ident="3591">
              <material>
                <mattext texttype="text/plain">Building stronger relationships</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">6558</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6558_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9955</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9955_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">3591</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="3591_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">7229</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="6558_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW235025370 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW235025370 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Addiction leads to a loss of control and can cause significant negative consequences, which prevents individuals from gaining valuable insights or personal growth.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW235025370 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9955_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW218995672 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW218995672 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Addiction fundamentally limits personal freedom and choice by creating a compulsive dependence on a substance or behavior, rather than enhancing it.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW218995672 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="3591_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW81209573 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW81209573 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Addiction often leads to deceit, broken trust, and failure to fulfill obligations, which typically damages relationships rather than building stronger ones.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW81209573 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gf41c1ec2aba490dd7710fff51c583ed1" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>true_false_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
