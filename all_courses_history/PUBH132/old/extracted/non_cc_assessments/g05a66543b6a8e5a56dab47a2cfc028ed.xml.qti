            <mattext texttype="text/html">&lt;span class="TextRun SCXW190004244 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW190004244 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Candles produce a very warm, dim light with negligible blue light emission and do not interfere with the sleep-wake cycle.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW190004244 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
