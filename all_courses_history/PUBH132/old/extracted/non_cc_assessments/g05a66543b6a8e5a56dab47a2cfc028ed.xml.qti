            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>158,6870,9164,8624,2215,1967</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Common signs of suicide risk include all of the following, &lt;strong&gt;except &lt;/strong&gt;&lt;span style="text-decoration: underline;"&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;.&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="158">
              <material>
                <mattext texttype="text/plain">talking about being a burden to others</mattext>
              </material>
            </response_label>
            <response_label ident="6870">
              <material>
                <mattext texttype="text/plain">looking for a way to kill themselves, such as searching online or buying a gun</mattext>
              </material>
            </response_label>
            <response_label ident="9164">
              <material>
                <mattext texttype="text/plain">talking about feeling hopeless or having no reason to live</mattext>
              </material>
            </response_label>
            <response_label ident="8624">
              <material>
                <mattext texttype="text/plain">sleeping too little or too much</mattext>
              </material>
            </response_label>
            <response_label ident="2215">
              <material>
                <mattext texttype="text/plain">withdrawing or isolating themselves</mattext>
              </material>
            </response_label>
            <response_label ident="1967">
              <material>
                <mattext texttype="text/plain">feeling sad about a new problem in their lives</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">1967</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
    <item ident="gee4cd1a9fb8a9aa9bc29c65356127a52" title="Question">
