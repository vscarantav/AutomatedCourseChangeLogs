          <conditionvar>
            <varequal respident="response1">3882</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="3882_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">457</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="457_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">4917</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="4917_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">779</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="3882_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW32337087 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW32337087 BCX8" data-ccp-parastyle="Normal (Web)"&gt; Generalized Anxiety Disorder (GAD) involves chronic and excessive worry about various everyday events, rather than an intense fear focused on one specific object or situation.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW32337087 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="457_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW58064631 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW58064631 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Social Anxiety Disorder is characterized by a significant fear of social situations, such as public speaking or meeting new people, not an irrational fear of a specific object or non-social situation.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW58064631 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="4917_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW112180763 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW112180763 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Post-Traumatic Stress Disorder (PTSD) develops after experiencing or &lt;/span&gt;&lt;span class="NormalTextRun SCXW112180763 BCX8" data-ccp-parastyle="Normal (Web)"&gt;witnessing&lt;/span&gt;&lt;span class="NormalTextRun SCXW112180763 BCX8" data-ccp-parastyle="Normal (Web)"&gt; a terrifying event and involves symptoms like flashbacks and avoidance, which are distinct from an irrational fear of a particular object or situation.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW112180763 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
