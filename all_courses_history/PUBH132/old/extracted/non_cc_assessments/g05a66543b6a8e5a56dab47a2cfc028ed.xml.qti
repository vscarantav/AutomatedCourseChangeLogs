        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">4226</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="4226_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">4797</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="4797_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">2744</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="9831_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW158355333 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW158355333 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Mood disorders, such as depression or bipolar disorder, primarily affect a person's emotional state or mood, not necessarily excessive and persistent &lt;/span&gt;&lt;span class="NormalTextRun SCXW158355333 BCX8" data-ccp-parastyle="Normal (Web)"&gt;worry&lt;/span&gt;&lt;span class="NormalTextRun SCXW158355333 BCX8" data-ccp-parastyle="Normal (Web)"&gt; and fear.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW158355333 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559685&amp;quot;:720,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="4226_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW210982851 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW210982851 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Psychotic disorders, like schizophrenia, involve a break from reality, often characterized by hallucinations or delusions, which are distinct from anxiety.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW210982851 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559685&amp;quot;:720,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="4797_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW236947533 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW236947533 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Personality disorders involve long-standing, inflexible patterns of thinking, feeling, and behaving that deviate from cultural expectations, which is a different category from anxiety.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW236947533 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559685&amp;quot;:720,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g93cf9ef9119bbad79906e2df0b3d460f" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>9177,5369,7702,8297</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW110717821 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW110717821 BCX8" data-ccp-parastyle="Normal (Web)"&gt;What anxiety disorder is characterized by chronic, excessive worrying about everyday events and activities, often without a specific focus?&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW110717821 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559685&amp;quot;:720,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="9177">
              <material>
                <mattext texttype="text/plain">Generalized Anxiety Disorder (GAD)</mattext>
              </material>
            </response_label>
            <response_label ident="5369">
              <material>
                <mattext texttype="text/plain">Panic Disorder</mattext>
              </material>
            </response_label>
            <response_label ident="7702">
              <material>
                <mattext texttype="text/plain">Obsessive-Compulsive Disorder (OCD)</mattext>
              </material>
            </response_label>
            <response_label ident="8297">
              <material>
                <mattext texttype="text/plain">Specific Phobia</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">5369</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="5369_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">7702</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="7702_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">8297</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="8297_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">9177</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="5369_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW47770021 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW47770021 BCX8" data-ccp-parastyle="Normal (Web)"&gt; Panic disorder is characterized by recurrent, unexpected panic attacks and persistent worry about having more attacks, not a chronic, generalized worry about everyday events.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW47770021 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559685&amp;quot;:720,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="7702_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW44419660 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW44419660 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Obsessive-Compulsive Disorder involves intrusive, unwanted thoughts (obsessions) and repetitive behaviors (compulsions) performed to alleviate anxiety, which is distinct from generalized worry.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW44419660 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559685&amp;quot;:720,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="8297_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW223803518 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW223803518 BCX8" data-ccp-parastyle="Normal (Web)"&gt;A s&lt;/span&gt;&lt;span class="NormalTextRun SCXW223803518 BCX8" data-ccp-parastyle="Normal (Web)"&gt;p&lt;/span&gt;&lt;span class="NormalTextRun SCXW223803518 BCX8" data-ccp-parastyle="Normal (Web)"&gt;ecific phobia is an intense and irrational fear of a particular object or situation (e.g., fear of heights, spiders), not a broad, generalized worrying about daily life.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW223803518 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559685&amp;quot;:1440,&amp;quot;335559740&amp;quot;:240,&amp;quot;335559991&amp;quot;:720}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g6b3c50fa2be76b515ef0ef569108ed20" title="Question">
