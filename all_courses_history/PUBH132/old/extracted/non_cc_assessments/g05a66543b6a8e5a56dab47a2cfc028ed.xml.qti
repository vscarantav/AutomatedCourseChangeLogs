                <mattext texttype="text/plain">7-9 hours</mattext>
              </material>
            </response_label>
            <response_label ident="5003">
              <material>
                <mattext texttype="text/plain">4-6 hours</mattext>
              </material>
            </response_label>
            <response_label ident="2072">
              <material>
                <mattext texttype="text/plain">10-12 hours</mattext>
              </material>
            </response_label>
            <response_label ident="8867">
