&lt;p&gt;The following statements about sleep are true &lt;strong&gt;except&lt;/strong&gt;&amp;nbsp;&lt;span style="text-decoration: underline;"&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;.&lt;/p&gt;
&lt;/div&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="54868">
              <material>
                <mattext texttype="text/plain">most adults need at least 7–9 hours of sleep a night</mattext>
              </material>
            </response_label>
            <response_label ident="96947">
              <material>
                <mattext texttype="text/plain">the temperature of your bedroom does not matter</mattext>
              </material>
            </response_label>
            <response_label ident="70767">
              <material>
                <mattext texttype="text/plain">blue light from electronics can delay sleep onset</mattext>
              </material>
            </response_label>
            <response_label ident="48792">
              <material>
                <mattext texttype="text/plain">regular exercise can improve your sleep patterns</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
