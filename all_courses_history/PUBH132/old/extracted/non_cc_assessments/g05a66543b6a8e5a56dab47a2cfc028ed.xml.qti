            <varequal respident="response1">6445</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="3637_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW266317333 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW266317333 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Obsessive-Compulsive Disorder (OCD) involves intrusive thoughts (obsessions&lt;/span&gt;&lt;span class="NormalTextRun ContextualSpellingAndGrammarErrorV2Themed SCXW266317333 BCX8" data-ccp-parastyle="Normal (Web)"&gt;)&lt;/span&gt;&lt;span class="NormalTextRun SCXW266317333 BCX8" data-ccp-parastyle="Normal (Web)"&gt; and repetitive behaviors (compulsions) performed to reduce anxiety, which is different from experiencing and worrying about panic attacks.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW266317333 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9619_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW184290513 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW184290513 BCX8" data-ccp-parastyle="Normal (Web)"&gt; A specific phobia is an intense and irrational fear of a particular object or situation, not the occurrence of unexpected panic attacks or the fear of future attacks.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW184290513 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="3579_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW30085073 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW30085073 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Major Depressive Disorder is a mood disorder characterized by persistent sadness, loss of interest, and other symptoms that affect daily functioning, and it is not defined by panic attacks or &lt;/span&gt;&lt;span class="NormalTextRun ContextualSpellingAndGrammarErrorV2Themed SCXW30085073 BCX8" data-ccp-parastyle="Normal (Web)"&gt;the fear&lt;/span&gt;&lt;span class="NormalTextRun SCXW30085073 BCX8" data-ccp-parastyle="Normal (Web)"&gt; of them.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW30085073 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g8eca8b666585a2393bcf1d3967626d5d" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>6766,2921,8771,7836</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW248410497 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW248410497 BCX8" data-ccp-parastyle="Normal (Web)"&gt;What anxiety disorder is characterized by a significant fear of social situations, such as public speaking or meeting new people?&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW248410497 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="6766">
              <material>
                <mattext texttype="text/plain">Social anxiety disorder</mattext>
              </material>
            </response_label>
            <response_label ident="2921">
              <material>
                <mattext texttype="text/plain">Agoraphobia</mattext>
              </material>
            </response_label>
            <response_label ident="8771">
              <material>
                <mattext texttype="text/plain">Separation Anxiety Disorder</mattext>
              </material>
            </response_label>
            <response_label ident="7836">
              <material>
                <mattext texttype="text/plain">Selective Mutism</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">2921</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="2921_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">8771</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="8771_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">7836</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="7836_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">6766</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="2921_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW207037051 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW207037051 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Agoraphobia is a fear of situations where escape might be difficult or embarrassing, often linked to a fear of having panic attacks in those places, rather than a primary fear of social interaction itself.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW207037051 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="8771_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW250448018 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW250448018 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Separation Anxiety Disorder involves excessive fear or anxiety concerning separation from attachment figures, not a fear of general social situations.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW250448018 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="7836_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW149871296 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW149871296 BCX8" data-ccp-parastyle="Normal (Web)"&gt; Selective mutism is a consistent failure to speak in specific social situations despite speaking in other situations. While often co-occurring with social &lt;/span&gt;&lt;span class="NormalTextRun SCXW149871296 BCX8" data-ccp-parastyle="Normal (Web)"&gt;anxiety, social anxiety disorder is the broader condition encompassing the fear of social situations.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW149871296 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
