        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW100557714 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW100557714 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Natural sunlight does &lt;/span&gt;&lt;span class="NormalTextRun SCXW100557714 BCX8" data-ccp-parastyle="Normal (Web)"&gt;contain&lt;/span&gt;&lt;span class="NormalTextRun SCXW100557714 BCX8" data-ccp-parastyle="Normal (Web)"&gt; blue light, which is beneficial during the day to regulate circadian rhythms, but the question refers to a source that interferes with sleep when used at night.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW100557714 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
