      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW258642349 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW258642349 BCX8" data-ccp-parastyle="Normal (Web)"&gt;What type of anxiety disorder is characterized by an intense, irrational fear of a particular object or situation?&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW258642349 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="779">
              <material>
                <mattext texttype="text/plain">Specific phobia</mattext>
              </material>
            </response_label>
            <response_label ident="3882">
              <material>
                <mattext texttype="text/plain">Generalized Anxiety Disorder (GAD)</mattext>
              </material>
            </response_label>
            <response_label ident="457">
              <material>
                <mattext texttype="text/plain">Social Anxiety Disorder</mattext>
              </material>
            </response_label>
            <response_label ident="4917">
              <material>
                <mattext texttype="text/plain">Post-Traumatic Stress Disorder (PTSD)</mattext>
              </material>
            </response_label>
          </render_choice>
