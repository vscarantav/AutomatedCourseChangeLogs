    <item ident="g04a521386ea72428d50228ad594e72cb" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>5521,1758,9194,7963</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW8228940 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW8228940 BCX8" data-ccp-charstyle="citation-1826" data-ccp-charstyle-defn="{&amp;quot;ObjectId&amp;quot;:&amp;quot;b90ceecd-35bb-5313-a133-7a7fc8ecc088|1&amp;quot;,&amp;quot;ClassId&amp;quot;:1073872969,&amp;quot;Properties&amp;quot;:[201342446,&amp;quot;1&amp;quot;,201342447,&amp;quot;5&amp;quot;,201342448,&amp;quot;1&amp;quot;,201342449,&amp;quot;1&amp;quot;,469777841,&amp;quot;Aptos&amp;quot;,469777842,&amp;quot;&amp;quot;,469777843,&amp;quot;Aptos&amp;quot;,469777844,&amp;quot;Aptos&amp;quot;,201341986,&amp;quot;1&amp;quot;,469769226,&amp;quot;Aptos&amp;quot;,268442635,&amp;quot;24&amp;quot;,469775450,&amp;quot;citation-1826&amp;quot;,201340122,&amp;quot;1&amp;quot;,134233614,&amp;quot;true&amp;quot;,469778129,&amp;quot;citation-1826&amp;quot;,335572020,&amp;quot;1&amp;quot;,469778324,&amp;quot;Default Paragraph Font&amp;quot;]}"&gt;What is the physical feeling experienced from the body's physiological response to an internal or external stimulus?&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW8228940 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="5521">
              <material>
                <mattext texttype="text/plain">Stress</mattext>
              </material>
            </response_label>
            <response_label ident="1758">
              <material>
                <mattext texttype="text/plain">Relaxation</mattext>
              </material>
            </response_label>
            <response_label ident="9194">
              <material>
                <mattext texttype="text/plain">Euphoria</mattext>
              </material>
            </response_label>
            <response_label ident="7963">
              <material>
                <mattext texttype="text/plain">Numbness</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">1758</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="1758_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9194</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9194_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">7963</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="7963_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">5521</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="1758_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="NormalTextRun SCXW68787646 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Relaxation is the opposite of stress, &lt;/span&gt;&lt;span class="NormalTextRun SCXW68787646 BCX8" data-ccp-parastyle="Normal (Web)"&gt;representing&lt;/span&gt;&lt;span class="NormalTextRun SCXW68787646 BCX8" data-ccp-parastyle="Normal (Web)"&gt; a state of reduced physiological arousal.&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9194_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW68787646 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW68787646 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Euphoria is an intense feeling of happiness or excitement, which is a positive emotional state, not the physiological response defining stress.&lt;/span&gt;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="7963_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW183313566 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW183313566 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Numbness is a lack of sensation or feeling, which does not define the body's physiological response to a stimulus as stress does.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW183313566 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="ga05d7216c374780663d99bab9b10e567" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>5941,919,1406,42</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW255569124 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW255569124 BCX8" data-ccp-charstyle="citation-1825" data-ccp-charstyle-defn="{&amp;quot;ObjectId&amp;quot;:&amp;quot;de2beebe-2179-504d-9f54-d17fd7951424|1&amp;quot;,&amp;quot;ClassId&amp;quot;:1073872969,&amp;quot;Properties&amp;quot;:[201342446,&amp;quot;1&amp;quot;,201342447,&amp;quot;5&amp;quot;,201342448,&amp;quot;1&amp;quot;,201342449,&amp;quot;1&amp;quot;,469777841,&amp;quot;Aptos&amp;quot;,469777842,&amp;quot;&amp;quot;,469777843,&amp;quot;Aptos&amp;quot;,469777844,&amp;quot;Aptos&amp;quot;,201341986,&amp;quot;1&amp;quot;,469769226,&amp;quot;Aptos&amp;quot;,268442635,&amp;quot;24&amp;quot;,469775450,&amp;quot;citation-1825&amp;quot;,201340122,&amp;quot;1&amp;quot;,134233614,&amp;quot;true&amp;quot;,469778129,&amp;quot;citation-1825&amp;quot;,335572020,&amp;quot;1&amp;quot;,469778324,&amp;quot;Default Paragraph Font&amp;quot;]}"&gt;What is another common name for the body's stress response?&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW255569124 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="5941">
              <material>
                <mattext texttype="text/plain">Fight or Flight response</mattext>
              </material>
            </response_label>
            <response_label ident="919">
              <material>
                <mattext texttype="text/plain">Rest and Digest response</mattext>
              </material>
            </response_label>
            <response_label ident="1406">
              <material>
                <mattext texttype="text/plain">Freeze and Observe response</mattext>
              </material>
            </response_label>
            <response_label ident="42">
              <material>
                <mattext texttype="text/plain">Calm and Collect response</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">919</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="919_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">1406</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="1406_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">42</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="42_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">5941</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="919_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="NormalTextRun SCXW180238911 BCX8" data-ccp-parastyle="Normal (Web)"&gt;The "Rest and Digest" response refers to the parasympathetic nervous system, which &lt;/span&gt;&lt;span class="NormalTextRun SCXW180238911 BCX8" data-ccp-parastyle="Normal (Web)"&gt;is responsible for&lt;/span&gt;&lt;span class="NormalTextRun SCXW180238911 BCX8" data-ccp-parastyle="Normal (Web)"&gt; calming the body and conserving energy, directly opposing the stress response. &lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="1406_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="NormalTextRun SCXW180238911 BCX8" data-ccp-parastyle="Normal (Web)"&gt;While "freeze" can be a &lt;/span&gt;&lt;span class="NormalTextRun SCXW180238911 BCX8" data-ccp-parastyle="Normal (Web)"&gt;component&lt;/span&gt;&lt;span class="NormalTextRun SCXW180238911 BCX8" data-ccp-parastyle="Normal (Web)"&gt; of a threat response, "Fight or Flight" is the specific and widely recognized term for the overall physiological preparation for perceived danger.&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="42_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW35097852 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW35097852 BCX8" data-ccp-parastyle="Normal (Web)"&gt; This phrase describes a state of tranquility and composure, which is the opposite of the body's activated stress response.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW35097852 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gf0aec36d2fe06718d972686cf6f2c7d7" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>1838,6413,1195,9299</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span class="TextRun SCXW163537347 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW163537347 BCX8" data-ccp-charstyle="citation-1824" data-ccp-charstyle-defn="{&amp;quot;ObjectId&amp;quot;:&amp;quot;197ae612-ba6c-5ef8-b882-14b64b1ec5d6|1&amp;quot;,&amp;quot;ClassId&amp;quot;:1073872969,&amp;quot;Properties&amp;quot;:[201342446,&amp;quot;1&amp;quot;,201342447,&amp;quot;5&amp;quot;,201342448,&amp;quot;1&amp;quot;,201342449,&amp;quot;1&amp;quot;,469777841,&amp;quot;Aptos&amp;quot;,469777842,&amp;quot;&amp;quot;,469777843,&amp;quot;Aptos&amp;quot;,469777844,&amp;quot;Aptos&amp;quot;,201341986,&amp;quot;1&amp;quot;,469769226,&amp;quot;Aptos&amp;quot;,268442635,&amp;quot;24&amp;quot;,469775450,&amp;quot;citation-1824&amp;quot;,201340122,&amp;quot;1&amp;quot;,134233614,&amp;quot;true&amp;quot;,469778129,&amp;quot;citation-1824&amp;quot;,335572020,&amp;quot;1&amp;quot;,469778324,&amp;quot;Default Paragraph Font&amp;quot;]}"&gt;When the brain interprets a warning signal as a threat, what substance is sent into the bloodstream from the adrenal glands?&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW163537347 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="1838">
              <material>
                <mattext texttype="text/plain">Epinephrine</mattext>
              </material>
            </response_label>
            <response_label ident="6413">
              <material>
                <mattext texttype="text/plain">Insulin</mattext>
              </material>
            </response_label>
            <response_label ident="1195">
              <material>
                <mattext texttype="text/plain">Dopamine</mattext>
              </material>
            </response_label>
            <response_label ident="9299">
              <material>
                <mattext texttype="text/plain">Serotonin</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">6413</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6413_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">1195</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="1195_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">9299</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="9299_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">1838</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="6413_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW4263745 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW4263745 BCX8" data-ccp-parastyle="Normal (Web)"&gt; Insulin is a hormone produced by the pancreas that regulates blood sugar levels and is not primarily involved in the immediate physiological stress response.&lt;/span&gt;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="1195_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW4263745 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW4263745 BCX8" data-ccp-parastyle="Normal (Web)"&gt; Dopamine is a neurotransmitter associated with pleasure, reward, and motivation, and while important for brain function, it is not the primary substance released from adrenal glands during an acute stress response.&lt;/span&gt;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="9299_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW142760456 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW142760456 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Serotonin is a neurotransmitter that influences mood, sleep, and digestion. It is not the main substance released from the adrenal glands in response to an immediate threat.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW142760456 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
