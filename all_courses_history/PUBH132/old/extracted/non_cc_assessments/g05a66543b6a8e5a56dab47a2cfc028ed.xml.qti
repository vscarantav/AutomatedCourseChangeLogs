      <itemfeedback ident="5003_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW195849047 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW195849047 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Sleeping only 4-6 hours is &lt;/span&gt;&lt;span class="NormalTextRun SCXW195849047 BCX8" data-ccp-parastyle="Normal (Web)"&gt;generally considered&lt;/span&gt;&lt;span class="NormalTextRun SCXW195849047 BCX8" data-ccp-parastyle="Normal (Web)"&gt; insufficient for adults and can lead to significant sleep deprivation and its associated negative health effects.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW195849047 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="2072_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW253512498 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW253512498 BCX8" data-ccp-parastyle="Normal (Web)"&gt; While some individuals may have higher sleep needs, sleeping 10-12 hours is typically more than the recommended range for the majority of adults.&lt;/span&gt;&lt;span class="NormalTextRun SCXW253512498 BCX8" data-ccp-parastyle="Normal (Web)"&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW253512498 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="8867_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW98987794 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW98987794 BCX8" data-ccp-parastyle="Normal (Web)"&gt;This range falls below the &lt;/span&gt;&lt;span class="NormalTextRun SCXW98987794 BCX8" data-ccp-parastyle="Normal (Web)"&gt;optimal&lt;/span&gt;&lt;span class="NormalTextRun SCXW98987794 BCX8" data-ccp-parastyle="Normal (Web)"&gt; amount for many adults, with the recommended range extending up to 9 hours for &lt;/span&gt;&lt;span class="NormalTextRun SCXW98987794 BCX8" data-ccp-parastyle="Normal (Web)"&gt;optimal&lt;/span&gt;&lt;span class="NormalTextRun SCXW98987794 BCX8" data-ccp-parastyle="Normal (Web)"&gt; health benefits.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW98987794 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
