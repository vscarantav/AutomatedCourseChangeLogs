        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">1799</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="1799_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">7543</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="3658_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW224231285 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW224231285 BCX8" data-ccp-parastyle="Normal (Web)"&gt; Sleep deprivation leads to decreased energy and fatigue, not an increase in energy.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW224231285 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559685&amp;quot;:720,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="5171_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW57618621 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW57618621 BCX8" data-ccp-parastyle="Normal (Web)"&gt; Lack of sufficient sleep typically impairs cognitive functions, including concentration and focus, rather than enhancing them.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW57618621 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559685&amp;quot;:720,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="1799_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;span class="TextRun SCXW23249770 BCX8" lang="EN-US" data-contrast="auto"&gt;&lt;span class="NormalTextRun SCXW23249770 BCX8" data-ccp-parastyle="Normal (Web)"&gt;Sleep deprivation is commonly associated with negative mood states, including irritability, mood swings, and feelings of depression, not an improved mood.&lt;/span&gt;&lt;/span&gt;&lt;span class="EOP SCXW23249770 BCX8" data-ccp-props="{&amp;quot;134233117&amp;quot;:true,&amp;quot;134233118&amp;quot;:true,&amp;quot;201341983&amp;quot;:0,&amp;quot;335559685&amp;quot;:720,&amp;quot;335559740&amp;quot;:240}"&gt;&amp;nbsp;&lt;/span&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g111d1fc1cf88eca3a54c065ca8d13847" title="Question">
      <itemmetadata>
        <qtimetadata>
