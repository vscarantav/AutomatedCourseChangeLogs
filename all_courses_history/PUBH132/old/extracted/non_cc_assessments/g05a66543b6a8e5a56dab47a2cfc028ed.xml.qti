              <material>
                <mattext texttype="text/plain">Progressive relaxation</mattext>
              </material>
            </response_label>
            <response_label ident="3280">
              <material>
                <mattext texttype="text/plain">Meditation</mattext>
              </material>
            </response_label>
            <response_label ident="7391">
              <material>
                <mattext texttype="text/plain">Biofeedback</mattext>
              </material>
            </response_label>
