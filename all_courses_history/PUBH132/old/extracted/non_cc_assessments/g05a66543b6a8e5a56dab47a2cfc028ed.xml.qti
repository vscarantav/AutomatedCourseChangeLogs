      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;span&gt;It is easy to overcome addiction. Individuals just need to choose to overcome their addiction, and then they will be able to stop "cold turkey." Professional help is rarely needed to treat addictions.&lt;/span&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="8720">
